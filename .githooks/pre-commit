#!/usr/bin/env bash
# .githooks/pre-commit — Automatically keeps VERSION, src/version.hpp, runtime stamps, and docs in sync on commit
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# 1. Ensure VERSION and src/version.hpp match
FILE_VER="$(tr -d '[:space:]' < VERSION 2>/dev/null || true)"
HDR_VER="$(sed -n 's/.*kVersion = "\([^"]*\)".*/\1/p' src/version.hpp | head -n 1)"

if [ -n "$FILE_VER" ] && [ -n "$HDR_VER" ] && [ "$FILE_VER" != "$HDR_VER" ]; then
    # If VERSION was staged, propagate VERSION -> src/version.hpp; otherwise src/version.hpp -> VERSION
    if git diff --cached --name-only | grep -qx "VERSION"; then
        sed "s/kVersion = \"[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\"/kVersion = \"${FILE_VER}\"/" src/version.hpp > src/version.hpp.tmp
        mv -f src/version.hpp.tmp src/version.hpp
        git add src/version.hpp
    else
        printf "%s\n" "$HDR_VER" > VERSION
        git add VERSION
    fi
fi

# 2. Build cfire and verify/auto-sync documentation & version manifests
make -s build

if ! ./cfire doc --check >/dev/null 2>&1; then
    echo "==> [pre-commit] Synchronizing documentation and version manifests via ./cfire doc..."
    SYNC_PATHS="VERSION src/version.hpp runtime/cfire_prelude.hpp docs/ .claude-plugin/"
    # Stage only what `cfire doc` regenerates (CF-159). If a generated file also has unstaged
    # hand edits, staging it would silently commit work the author did not stage, so stop instead.
    BEFORE="$(git diff --name-only -- $SYNC_PATHS | sort)"
    BEFORE_HASHES="$(for f in $BEFORE; do [ -f "$f" ] && git hash-object "$f"; done)"
    UNTRACKED_BEFORE="$(git ls-files --others --exclude-standard -- $SYNC_PATHS | sort)"
    ./cfire doc
    AFTER="$(git diff --name-only -- $SYNC_PATHS | sort)"
    UNTRACKED_AFTER="$(git ls-files --others --exclude-standard -- $SYNC_PATHS | sort)"
    NEW_FILES="$(comm -13 <(printf "%s\n" "$UNTRACKED_BEFORE") <(printf "%s\n" "$UNTRACKED_AFTER"))"
    CONFLICTS=""
    i=0
    for f in $BEFORE; do
        i=$((i + 1))
        old_hash="$(printf "%s\n" "$BEFORE_HASHES" | sed -n "${i}p")"
        [ -f "$f" ] && [ "$(git hash-object "$f")" != "$old_hash" ] && CONFLICTS="$CONFLICTS $f"
    done
    if [ -n "$CONFLICTS" ]; then
        echo "==> [pre-commit] cfire doc regenerated files that also have unstaged edits:$CONFLICTS" >&2
        echo "    Review them, stage what you intend to commit (git add -p), and commit again." >&2
        exit 1
    fi
    REGENERATED="$(comm -13 <(printf "%s\n" "$BEFORE") <(printf "%s\n" "$AFTER"))"
    for f in $REGENERATED $NEW_FILES; do
        [ -n "$f" ] && git add -- "$f" && echo "    staged regenerated $f"
    done
    ./cfire doc --check
fi

# 3. The every-commit tier (CF-186): zero warnings, formatting, examples, unit/e2e/stdlib, GUIDE doc-tests and the
#    conformance corpus. It tests the working tree, so unstaged edits count too. A failure blocks the commit.
#    Git exports GIT_DIR / GIT_INDEX_FILE to hooks (from a worktree); a test's `git -C <tmp> init` would then
#    reinitialise this repository (`core.bare = true`), so the tests run without them.
if ! env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE make -s check; then
    echo "==> [pre-commit] make check failed; fix it and commit again (docs/planning/README.md, Quality Gates)." >&2
    exit 1
fi
