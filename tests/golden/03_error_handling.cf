package main

fn parse_even(s: str) -> i64! {
    if s == "fail" {
        return error("simulated parse failure")
    }
    val := 42
    if val % 2 != 0 {
        return error("odd number rejected")
    }
    return val
}

fn find_name(id: i32) -> str? {
    if id == 1 {
        return "alice"
    }
    return none
}

fn main() -> void! {
    num := try parse_even("42")
    user := find_name(1) or { return error("user not found") }
    println("user {} with num {}", user, num)
}
