package main

import "./ui"
import "core:audio"
import "core:os"
import "vendor:raylib" as rl

fn main() {
    headless := os.getenv("CFIRE_HEADLESS_TEST", "") == "1"
    if !headless {
        rl.InitWindow(0, 0, "Pocket Studio")
        rl.SetTargetFPS(60)
    }
    defer rl.CloseWindow()

    try audio.init(48000, 2)
    defer audio.close()
    audio.set_master_volume(0.65)

    tap_sfx := audio_sound_from_wave(audio.gen_sfx(audio.SfxPreset::T1eap))
    sync_sfx := audio.load_sound_from_wave(audio.gen_sfx(audio.SfxPreset::Coin))
    dsp_stream := try audio.open_stream(48000, 2)
    pad_wave := audio.gen_tone(audio.Waveform::Sine, 220.0, 0.04, 0.25)

    mut ctx := ui.make_context()
    mut active_tab: i32 = 0
    mut dark_mode := true
    mut no