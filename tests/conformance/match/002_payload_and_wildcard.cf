// expect: stdout
// | 314 40 0
package main
type Shape enum {
    Circle(f64),
    Rect(f64, f64),
    Empty,
}
fn area(s: Shape) -> i64 {
    return match s {
        Circle(r) => i64(3.14 * r * r),
        Rect(w, h) => i64(w * h),
        _ => i64(0),
    }
}
fn main() {
    println("{} {} {}", area(Shape::Circle(10.0)), area(Shape::Rect(5.0, 8.0)), area(Shape::Empty))
}
