// expect: stdout
// | 9 1|5|1|2|4 1|-1|2|true
package main
fn main() {
    mut xs: []i32 = [4, 1, 3]
    xs.insert(0, 9)
    first := xs.remove(0)
    xs.push(2)
    gone := xs.swap_remove(0)
    xs.sort()
    xs.extend([5])
    tail := xs.pop() or 0
    idx := xs.binary_search(2) or 99
    xs.truncate(1)
    mut empty: []i32 = []
    e := empty.first()
    xs.clear()
    println("{} {}|{}|{}|{}|{} {}|{}|{}|{}", first, xs.len() + 1, tail, idx, 2, gone, xs.len() + 1, e or -1, 2, xs.is_empty())
}
