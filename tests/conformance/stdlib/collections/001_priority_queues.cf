// expect: stdout
// | max 9 2
// | min 1 3 9
// | cost 2 cell 7
// | struct 1
// | empty
package main
import "core:collections"
// Q44 (CF-183): `pop() -> T?` on both queues; `MinQueue` pops the smallest first; tuples and structs order
// field by field.
type State struct {
    cost: i64
    cell: i64
}
fn main() {
    mut pq := collections.PriorityQueue[i64]{}
    pq.push(3)
    pq.push(9)
    pq.push(1)
    top := pq.pop() or { return }
    println("max {} {}", top, pq.len())
    mut mq: collections.MinQueue[i64] = collections.MinQueue[i64]{}
    mq.push(3)
    mq.push(9)
    mq.push(1)
    mut out: []i64 = []
    for !mq.empty() {
        x := mq.pop() or { break }
        out.push(x)
    }
    println("min {} {} {}", out[0], out[1], out[2])
    mut tq := collections.MinQueue[(i64, i64)]{}
    tq.push((5, 1))
    tq.push((2, 7))
    t := tq.pop() or { return }
    (cost, cell) := t
    println("cost {} cell {}", cost, cell)
    mut sq := collections.MinQueue[State]{}
    sq.push(State{cost: 4, cell: 0})
    sq.push(State{cost: 1, cell: 9})
    best := sq.pop() or { return }
    println("struct {}", best.cost)
    if mq.pop() == none {
        println("empty")
    }
}
