// Cross-platform local IPC listener, connect, text/byte streaming, peer_credentials, and listener close semantics.
// expect: stdout
// | peer_ok=true
// | server_got=ping:123
// | client_got=pong
package main

import "core:net/ipc"
import "core:os"
import "core:sync"

fn main() -> void! {
    ep := ipc.endpoint("conf-ipc-{os.getpid()}")
    mut ln := try ipc.listen(ep)
    defer ln.close()

    ch := make(sync.Channel[str], capacity: 1)
    mut peer_ok := false
    mut srv_msg := ""

    async.scope(workers: 2) |scope| {
        scope.spawn || {
            mut c := ipc.connect(ep, 3000) or err {
                eprintln("ipc connect error: {}", err.message())
                exit(1)
            }
            defer c.close()
            _ = c.write_text("ping:") or err {
                eprintln("ipc write_text error: {}", err.message())
                exit(1)
            }
            pkt: []byte = [byte('1'), byte('2'), byte('3')]
            _ = c.write_bytes(pkt) or err {
                eprintln("ipc write_bytes error: {}", err.message())
                exit(1)
            }
            reply := c.read_text(16) or err {
                eprintln("ipc read_text error: {}", err.message())
                exit(1)
            }
            ch.send(reply)
        }

        mut srv_conn := try ln.accept()
        defer srv_conn.close()
        cred := try srv_conn.peer_credentials()
        peer_ok = cred.same_user && (cred.pid == os.getpid())
        ln.close()

        part1 := try srv_conn.read_text(5)
        part2 := try srv_conn.read_exact(3)
        srv_msg = part1 + str(part2)
        _ = try srv_conn.write_text("pong")
    }

    cli_msg := ch.recv() or ""
    println("peer_ok={}", peer_ok)
    println("server_got={}", srv_msg)
    println("client_got={}", cli_msg)
}
