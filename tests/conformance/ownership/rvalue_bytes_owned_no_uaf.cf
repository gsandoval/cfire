// expect: stdout
// | 65 110 32 97 103 101 110 116
package main

fn text() -> str {
    return "An agent is waiting for your approval, a text long enough to leave the SSO buffer"
}

fn main() {
    body := text().bytes()
    mut parts: []str = []
    mut i: usize = 0
    for i < 8 && i < body.len() {
        parts.push("{u8(body[i])}")
        i += 1
    }
    println(parts.join(" "))
}
