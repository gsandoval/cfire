// expect: stdout
// | 44 255 0 7 2147483647 0 -1 3
package main
fn main() {
    n: i32 = 300
    neg: i32 = -5
    big: f64 = 1e20
    nan: f64 = 0.0 / 0.0
    a := n.wrapping_as[u8]()
    b := n.saturating_as[u8]()
    c := neg.saturating_as[u8]()
    d := n.try_as[u8]() or 7
    e := big.saturating_as[i32]()
    f := nan.saturating_as[i32]()
    g := big.try_as[i64]() or -1
    h := neg.try_as[i8]() or 0
    println("{} {} {} {} {} {} {} {}", a, b, c, d, e, f, g, h + 8)
}
