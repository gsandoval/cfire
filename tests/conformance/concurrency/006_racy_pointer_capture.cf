// CF-189: tasks cannot share a plain mutable variable (there are no pointers to pass around instead); a shared
// counter is a sync.Atomic or a sync.Mutex, or each task returns its part (Q51).
package main
fn main() {
    mut counter: i64 = 0
    async.scope(workers: 8) |scope| {
        for w in 0..8 {
            scope.spawn || {
                counter += 1 //~ error cfire/ESCAPING-CAPTURE-MUT
            }
        }
    }
    println("counter={}", counter)
}
