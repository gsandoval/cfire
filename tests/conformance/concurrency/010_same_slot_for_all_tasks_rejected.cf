// Q51 (CF-189): a slot index that is not the spawning loop's own index gives every task the same element.
package main
fn main() {
    mut codes: []i32 = [0, 0, 0, 0]
    async.scope(workers: 4) |scope| {
        for i, c in codes {
            scope.spawn |mut codes[0]| { //~ error cfire/SPAWN-SHARED-MUT
                codes[0] = i32(i)
            }
        }
    }
    println("{}", codes[0])
}
