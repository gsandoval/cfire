// expect: stdout
// | 2 1 true
package main
fn main() {
    lines := ["L68", "R48", "L5"]
    mut left := 0
    mut right := 0
    for line in lines {
        if line[0] == 'L' {
            left += 1
        } else if line[0] == 'R' {
            right += 1
        }
    }
    nl: byte = '\n'
    println("{} {} {}", left, right, nl == byte(10) && '\x41' == byte(65) && '\'' == byte(39))
}
