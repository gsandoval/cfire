package main
import "core:os"
fn build(u: str) -> str {
    return "ls " + u
}
fn run(cmd: str) -> str {
    return os.exec(cmd) or "" //~ error cfire/SHELL-INJECTION-RISK
}
fn main() {
    user := os.args()[0]
    a := os.exec(build(user)) or "" //~ error cfire/SHELL-INJECTION-RISK
    b := os.exec("ls {user}") or "" //~ error cfire/SHELL-INJECTION-RISK
    println("{} {} {}", a, b, run(user))
}
