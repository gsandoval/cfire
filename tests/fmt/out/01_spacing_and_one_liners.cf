type P struct {
    a: i32 = -1
    b: str // the b
}

fn f(mut p: P, x: i32) -> i32 {
    p.a += x
    return p.a * -1
}

fn main() {
    mut q := P{a: 1, b: "x"}
    v := f(mut q, 2)
    println("{}", v)
}
