package doc

// src/docgen.cf — Self-Hosted Documentation Generator for cfire

type StdFnDoc struct {
    name: str
    cf_sig: str
    cpp_lowering: str
    summary: str
    example: str
}

type StdModuleDoc struct {
    import_path: str
    ns_alias: str
    title: str
    link_flags: str
    overview: str
    functions: []StdFnDoc
}

type DiagnosticDoc struct {
    code: str
    title: str
    rule: str
    bad_example: str
    good_example: str
}

type DocStruct struct {
    name: str
    doc_comment: str
    formatted_sig: str
}

type DocEnum struct {
    name: str
    doc_comment: str
    formatted_sig: str
}

type DocFunction struct {
    name: str
    doc_comment: str
    formatted_sig: str
}

type DocTest struct {
    name: str
    line: usize
}

// doc_usize_to_str: Converts non-negative integer to string representation
fn doc_usize_to_str(val: usize) -> str {
    if val == 0 {
        return "0"
    }
    mut v := val
    mut digits: str = ""
    for v > 0 {
        d := v % 10
        if d == 0 {
            digits = "0" + digits
        } else if d == 1 {
            digits = "1" + digits
        } else if d == 2 {
            digits = "2" + digits
        } else if d == 3 {
            digits = "3" + digits
        } else if d == 4 {
            digits = "4" + digits
        } else if d == 5 {
            digits = "5" + digits
        } else if d == 6 {
            digits = "6" + digits
        } else if d == 7 {
            digits = "7" + digits
        } else if d == 8 {
            digits = "8" + digits
        } else if d == 9 {
            digits = "9" + digits
        }
        v = v / 10
    }
    return digits
}

// html_escape: Escapes HTML special characters (&, <, >, ")
fn html_escape(sv: &str) -> str {
    mut escaped: str = ""
    mut start: usize = 0
    mut i: usize = 0
    n := sv.len
    for i < n {
        c := sv[i]
        if c == 38 || c == 60 || c == 62 || c == 34 { // '&', '<', '>', '"'
            if i > start {
                escaped += sv[start..i]
            }
            if c == 38 {
                escaped += "&amp;"
            } else if c == 60 {
                escaped += "&lt;"
            } else if c == 62 {
                escaped += "&gt;"
            } else if c == 34 {
                escaped += "&quot;"
            }
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        escaped += sv[start..n]
    }
    return escaped
}

// navbar_html: Emits consistent responsive navigation bar across all HTML documentation pages
fn navbar_html(active_page: &str) -> str {
    mut idx_class: str = ""
    if active_page == "index" {
        idx_class = "active"
    }
    mut guide_class: str = ""
    if active_page == "guide" {
        guide_class = "active"
    }
    mut ref_class: str = ""
    if active_page == "reference" {
        ref_class = "active"
    }

    mut s: str = "\n<nav class=\"navbar\">\n"
    s += "  <div class=\"navbar-inner\">\n"
    s += "    <a class=\"brand\" href=\"index.html\">\n"
    s += "      <img src=\"assets/cfire_logo_emblem.png\" alt=\"cfire logo\" class=\"brand-icon\" />\n"
    s += "      <span class=\"brand-text\">c<span class=\"fire\">fire</span></span>\n"
    s += "      <span class=\"brand-badge\">ISO C++23</span>\n"
    s += "    </a>\n"
    s += "    <div class=\"nav-links\">\n"
    s += "      <a href=\"index.html\" class=\""
    s += idx_class
    s += "\">Overview</a>\n"
    s += "      <a href=\"guide.html\" class=\""
    s += guide_class
    s += "\">Guide</a>\n"
    s += "      <a href=\"reference.html\" class=\""
    s += ref_class
    s += "\">Stdlib</a>\n"
    s += "      <a href=\"https://github.com/gsandoval/cfire\" target=\"_blank\" rel=\"noopener\">GitHub &rarr;</a>\n"
    s += "      <a href=\"index.html#install\" class=\"btn-nav-primary\">Install</a>\n"
    s += "    </div>\n"
    s += "  </div>\n"
    s += "</nav>\n"
    return s
}

// generate_reference_markdown: Compiles the live metadata catalog into STDLIB_REFERENCE.md
fn generate_reference_markdown(
    modules: []StdModuleDoc,
    diags: []DiagnosticDoc,
    examples: []str
) -> str {
    mut s: str = "# `cfire` Standard Library (`core:*`) & Diagnostics Reference\n\n"
    s += "> Auto-generated from the compiler's single-source-of-truth catalog via `./cfire doc`.\n\n"
    s += "## 1. Built-In `core:*` Standard Library Modules\n\n"

    mut mi: usize = 0
    num_mods := modules.len
    for mi < num_mods {
        mod := modules[mi]
        s += "### `"
        s += mod.import_path
        s += "` (`"
        s += mod.ns_alias
        s += "`) — "
        s += mod.title
        s += "\n\n- **Auto-Link Flags:** `"
        s += mod.link_flags
        s += "`\n- **Overview:** "
        s += mod.overview
        s += "\n\n"

        if mi < examples.len && examples[mi].len > 0 {
            s += "**Practical Example:**\n```cf\n"
            s += examples[mi]
            s += "\n```\n\n"
        }

        s += "| `.cf` Signature | Lowered C++23 | Description | Example |\n"
        s += "|---|---|---|---|\n"

        mut fi: usize = 0
        num_fns := mod.functions.len
        for fi < num_fns {
            fn_doc := mod.functions[fi]
            s += "| `"
            s += fn_doc.cf_sig
            s += "` | `"
            s += fn_doc.cpp_lowering
            s += "` | "
            s += fn_doc.summary
            s += " | `"
            s += fn_doc.example
            s += "` |\n"
            fi = fi + 1
        }
        s += "\n"
        mi = mi + 1
    }

    s += "## 2. Semantic Diagnostic Codes\n\n"
    mut di: usize = 0
    num_diags := diags.len
    for di < num_diags {
        d := diags[di]
        s += "### `["
        s += d.code
        s += "]` — "
        s += d.title
        s += "\n\n"
        s += d.rule
        s += "\n\n**Rejected (`.cf`):**\n```cf\n"
        s += d.bad_example
        s += "\n```\n\n**Accepted (`.cf`):**\n```cf\n"
        s += d.good_example
        s += "\n```\n\n"
        di = di + 1
    }
    return s
}

// generate_reference_html: Compiles the live metadata catalog into docs/reference.html
fn generate_reference_html(
    modules: []StdModuleDoc,
    diags: []DiagnosticDoc,
    shared_css: &str,
    examples: []str
) -> str {
    mut s: str = "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n"
    s += "  <meta charset=\"UTF-8\" />\n"
    s += "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n"
    s += "  <title>Stdlib &amp; Diagnostics Reference — cfire</title>\n"
    s += "  <style>"
    s += shared_css
    s += "</style>\n"
    s += "</head>\n<body>\n"
    s += navbar_html("reference")
    s += "<div class=\"container\">\n"
    s += "  <div class=\"doc-layout\">\n"
    s += "    <aside class=\"sidebar\">\n"
    s += "      <details class=\"sidebar-details\" open>\n"
    s += "        <summary class=\"sidebar-summary\">\n"
    s += "          <span>Modules &amp; Diagnostics</span>\n"
    s += "          <span class=\"sidebar-chevron\">&#9662;</span>\n"
    s += "        </summary>\n"
    s += "        <div class=\"sidebar-content\">\n"
    s += "          <h4>`core:*` Modules</h4>\n          <ul>\n"

    mut mi: usize = 0
    num_mods := modules.len
    for mi < num_mods {
        mod := modules[mi]
        s += "            <li><a href=\"#mod-"
        s += mod.ns_alias
        s += "\"><code>"
        s += mod.import_path
        s += "</code></a></li>\n"
        mi = mi + 1
    }

    s += "          </ul>\n          <h4 style=\"margin-top:1.25rem;\">Diagnostics</h4>\n          <ul>\n"

    mut di: usize = 0
    num_diags := diags.len
    for di < num_diags {
        d := diags[di]
        s += "            <li><a href=\"#diag-"
        s += d.code
        s += "\"><code>"
        s += d.code
        s += "</code></a></li>\n"
        di = di + 1
    }

    s += "          </ul>\n        </div>\n      </details>\n    </aside>\n    <main>\n"
    s += "      <h1>`core:*` Standard Library &amp; Diagnostics Reference</h1>\n"
    s += "      <p class=\"subtitle\" style=\"margin:0 0 2rem;\">Automatically generated from the live <code>cfire</code> compiler metadata catalog and verified by <code>cfire doc --check</code>.</p>\n"

    mut m2: usize = 0
    for m2 < num_mods {
        mod := modules[m2]
        s += "      <h2 id=\"mod-"
        s += mod.ns_alias
        s += "\"><code>import \""
        s += mod.import_path
        s += "\"</code> &mdash; "
        s += html_escape(mod.title)
        s += "</h2>\n"

        s += "      <p>"
        s += mod.overview
        s += " <br/><small style=\"color:var(--muted)\">Auto-linked flags: <code>"
        s += html_escape(mod.link_flags)
        s += "</code></small></p>\n"

        if m2 < examples.len && examples[m2].len > 0 {
            s += "      <div class=\"code-header\"><span class=\"tag-cf\">Practical Workflow Example</span></div>\n"
            s += "      <pre><code>"
            s += html_escape(examples[m2])
            s += "</code></pre>\n"
        }

        s += "      <div class=\"table-wrap api-table-wrap\"><table>\n        <thead><tr><th>`.cf` Signature</th><th>C++23 Lowering</th><th>Description &amp; Example</th></tr></thead>\n        <tbody>\n"

        mut fi: usize = 0
        num_fns := mod.functions.len
        for fi < num_fns {
            fn_doc := mod.functions[fi]
            s += "          <tr><td><code>"
            s += html_escape(fn_doc.cf_sig)
            s += "</code></td><td><code>"
            s += html_escape(fn_doc.cpp_lowering)
            s += "</code></td><td>"
            s += html_escape(fn_doc.summary)
            s += "<br/><code>"
            s += html_escape(fn_doc.example)
            s += "</code></td></tr>\n"
            fi = fi + 1
        }

        s += "        </tbody>\n      </table></div>\n"
        m2 = m2 + 1
    }

    s += "      <h2 class=\"section-title\">Compiler Semantic Diagnostics</h2>\n"

    mut d2: usize = 0
    for d2 < num_diags {
        d := diags[d2]
        s += "      <div class=\"card\" id=\"diag-"
        s += d.code
        s += "\" style=\"margin-bottom:1.25rem;\">\n"

        s += "        <h3><code>["
        s += d.code
        s += "]</code> &mdash; "
        s += html_escape(d.title)
        s += "</h3>\n"

        s += "        <p style=\"margin-bottom:0.85rem;\">"
        s += html_escape(d.rule)
        s += "</p>\n"

        s += "        <div class=\"grid-2\">\n"
        s += "          <div><div class=\"code-header\"><span style=\"color:var(--err);font-weight:700;\">Rejected (.cf)</span></div><pre><code>"
        s += html_escape(d.bad_example)
        s += "</code></pre></div>\n"

        s += "          <div><div class=\"code-header\"><span style=\"color:var(--ok);font-weight:700;\">Accepted (.cf)</span></div><pre><code>"
        s += html_escape(d.good_example)
        s += "</code></pre></div>\n"

        s += "        </div>\n      </div>\n"
        d2 = d2 + 1
    }

    s += "    </main>\n  </div>\n</div>\n"
    s += "<footer class=\"footer\">Generated by <code>cfire doc</code> &bull; Always kept in sync with <code>src/docgen.hpp</code>.</footer>\n"
    s += "</body>\n</html>\n"
    return s
}

// format_package_markdown: Formats single-file package API documentation extracted by `cfire doc <file.cf>`
fn format_package_markdown(
    pkg_name: &str,
    file_name: &str,
    imports: []str,
    structs: []DocStruct,
    enums: []DocEnum,
    functions: []DocFunction,
    tests: []DocTest
) -> str {
    mut md: str = "# Package `"
    md += pkg_name
    md += "` (`"
    md += file_name
    md += "`)\n\n"

    if imports.len > 0 {
        md += "## Imports\n"
        mut i: usize = 0
        for i < imports.len {
            md += "- `\""
            md += imports[i]
            md += "\"`\n"
            i = i + 1
        }
        md += "\n"
    }

    if structs.len > 0 {
        md += "## Structs\n\n"
        mut i: usize = 0
        for i < structs.len {
            st := structs[i]
            md += "### `type "
            md += st.name
            md += " struct`\n"
            if st.doc_comment.len > 0 {
                md += st.doc_comment
                md += "\n\n"
            }
            md += "```cf\n"
            md += st.formatted_sig
            md += "\n```\n\n"
            i = i + 1
        }
    }

    if enums.len > 0 {
        md += "## Algebraic Enums\n\n"
        mut i: usize = 0
        for i < enums.len {
            en := enums[i]
            md += "### `type "
            md += en.name
            md += " enum`\n"
            if en.doc_comment.len > 0 {
                md += en.doc_comment
                md += "\n\n"
            }
            md += "```cf\n"
            md += en.formatted_sig
            md += "\n```\n\n"
            i = i + 1
        }
    }

    if functions.len > 0 {
        md += "## Functions\n\n"
        mut i: usize = 0
        for i < functions.len {
            fn_doc := functions[i]
            md += "### `"
            md += fn_doc.formatted_sig
            md += "`\n"
            if fn_doc.doc_comment.len > 0 {
                md += fn_doc.doc_comment
                md += "\n\n"
            }
            i = i + 1
        }
    }

    if tests.len > 0 {
        md += "## Built-in Tests\n\n"
        mut i: usize = 0
        for i < tests.len {
            t := tests[i]
            md += "- `test \""
            md += t.name
            md += "\"` (line "
            md += doc_usize_to_str(t.line)
            md += ")\n"
            i = i + 1
        }
        md += "\n"
    }

    return md
}
