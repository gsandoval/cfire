package codegen
// src/codegen.cf — C++23 Code Generator, Header & Test Harness Emitter
// Self-hosted in pure cfire, generating standard ISO C++23 code with 100% parity.

type CppHeaderInfo struct {
    path: str
    defines: []str
}

type TypeDeclItem struct {
    line: i32
    is_enum: bool
    idx: usize
}

type CodegenEmitter struct {
    buf: str
    indent_level: i32
    test_mode: bool
}

fn codegen_starts_with(s: str, prefix: str) -> bool {
    n := s.len
    pn := prefix.len
    if pn > n {
        return false
    }
    return s[0..pn] == prefix
}

fn clean_header_path(path: str) -> str {
    mut p := path
    for p.len > 0 && (p[0] == 60 || p[0] == 34) { // '<' or '"'
        p = p[1..p.len]
    }
    for p.len > 0 && (p[p.len - 1] == 62 || p[p.len - 1] == 34) { // '>' or '"'
        p = p[0..p.len - 1]
    }
    return p
}

fn (mut e: CodegenEmitter) write(s: str) {
    e.buf += s
}

fn (mut e: CodegenEmitter) writeln(s: str) {
    if s.len == 0 {
        e.buf += "\n"
        return
    }
    mut i: i32 = 0
    for i < e.indent_level {
        e.buf += "    "
        i = i + 1
    }
    e.buf += s + "\n"
}

fn (mut e: CodegenEmitter) emit_file(cf: cpp::cfire::frontend::CheckedFile) -> str {
    mut link_tags: []str = []
    mut defines: []str = []
    mut cpp_headers: []CppHeaderInfo = []
    mut used_core: map[str]bool
    mut used_vendor: map[str]str

    // 1. Process imports
    mut imp_i: usize = 0
    n_imp := cf.ast.imports.len
    for imp_i < n_imp {
        imp := cf.ast.imports[imp_i]
        if imp.is_cpp {
            mut h_defines: []str = []
            mut at_i: usize = 0
            n_at := imp.attrs.len
            for at_i < n_at {
                attr := imp.attrs[at_i]
                if attr.name == "pkg" && attr.args.len > 0 {
                    link_tags.push("@pkg:" + attr.args[0])
                } else if attr.name == "define" && attr.args.len > 0 {
                    if attr.args.len == 1 {
                        h_defines.push("#define " + attr.args[0])
                    } else if attr.args.len >= 2 {
                        h_defines.push("#define " + attr.args[0] + " " + attr.args[1])
                    }
                }
                at_i = at_i + 1
            }
            cpp_headers.push(CppHeaderInfo{path: imp.path, defines: h_defines})
        } else {
            ipath := imp.path
            if ipath == "core:fs" {
                used_core["fs"] = true
            } else if ipath == "core:cli" {
                used_core["cli"] = true
            } else if ipath == "core:compress/zstd" || ipath == "core:compress" || ipath == "core:zstd" || codegen_starts_with(ipath, "core:compress/") {
                used_core["compress"] = true
                defines.push("#define CFIRE_USE_ZSTD 1")
                link_tags.push("-lzstd")
            } else if ipath == "core:json" {
                used_core["json"] = true
                defines.push("#define CFIRE_USE_SIMDJSON 1")
                link_tags.push("-lsimdjson")
            } else if ipath == "core:db/sqlite" || ipath == "core:sqlite" {
                used_core["sqlite"] = true
                defines.push("#define CFIRE_USE_SQLITE 1")
                link_tags.push("-lsqlite3")
            } else if ipath == "core:crypto" || codegen_starts_with(ipath, "core:crypto/") {
                used_core["crypto"] = true
            } else if ipath == "core:net" || ipath == "core:http" || ipath == "core:websocket" || codegen_starts_with(ipath, "core:net/") {
                used_core["net"] = true
            } else if ipath == "core:time" {
                used_core["time"] = true
            } else if ipath == "core:os" {
                used_core["os"] = true
            } else if ipath == "core:sync" || ipath == "core:context" || codegen_starts_with(ipath, "core:sync/") {
                used_core["sync"] = true
            } else if ipath == "core:str" {
                used_core["str"] = true
            } else if ipath == "core:math" || ipath == "core:rand" {
                used_core["math"] = true
            } else if codegen_starts_with(ipath, "core:encoding/") || ipath == "core:encoding" || ipath == "core:base64" || ipath == "core:hex" || ipath == "core:csv" {
                used_core["encoding"] = true
            } else if ipath == "core:regex" {
                used_core["regex"] = true
            } else if ipath == "core:collections" || ipath == "core:sort" {
                used_core["collections"] = true
            } else if ipath == "core:log" {
                used_core["log"] = true
            } else if ipath == "core:unicode" {
                used_core["unicode"] = true
            } else if codegen_starts_with(ipath, "core:") {
                mod_name := ipath[5..ipath.len]
                used_core[mod_name] = true
            } else if ipath == "vendor:raylib" {
                mut alias := "raylib"
                if imp.alias.len > 0 {
                    alias = imp.alias
                }
                used_vendor["raylib"] = alias
                link_tags.push("-lraylib")
            }
        }
        imp_i = imp_i + 1
    }

    // 2. Emit link directives
    if link_tags.len > 0 {
        mut joined: str = ""
        mut lti: usize = 0
        n_lt := link_tags.len
        for lti < n_lt {
            if lti > 0 {
                joined = joined + " "
            }
            joined = joined + link_tags[lti]
            lti = lti + 1
        }
        e.writeln("// @cfire-link: " + joined)
    }

    // 3. Emit defines
    mut di: usize = 0
    n_def := defines.len
    for di < n_def {
        e.writeln(defines[di])
        di = di + 1
    }

    // 4. Emit includes
    e.writeln("#include \"cfire_prelude.hpp\"")
    if used_core.len > 0 {
        if used_core["cli"] {
            e.writeln("#include \"core/cli.hpp\"")
        }
        if used_core["collections"] || used_core["sort"] {
            e.writeln("#include \"core/collections.hpp\"")
        }
        if used_core["zstd"] || used_core["compress"] {
            e.writeln("#include \"core/compress.hpp\"")
        }
        if used_core["crypto"] {
            e.writeln("#include \"core/crypto.hpp\"")
        }
        if used_core["encoding"] || used_core["base64"] || used_core["hex"] || used_core["csv"] {
            e.writeln("#include \"core/encoding.hpp\"")
        }
        if used_core["fs"] {
            e.writeln("#include \"core/fs.hpp\"")
        }
        if used_core["json"] {
            e.writeln("#include \"core/json.hpp\"")
        }
        if used_core["log"] {
            e.writeln("#include \"core/log.hpp\"")
        }
        if used_core["math"] || used_core["rand"] {
            e.writeln("#include \"core/math.hpp\"")
        }
        if used_core["net"] || used_core["http"] || used_core["websocket"] || used_core["url"] {
            e.writeln("#include \"core/net.hpp\"")
        }
        if used_core["os"] {
            e.writeln("#include \"core/os.hpp\"")
        }
        if used_core["regex"] {
            e.writeln("#include \"core/regex.hpp\"")
        }
        if used_core["sqlite"] {
            e.writeln("#include \"core/sqlite.hpp\"")
        }
        if used_core["str"] {
            e.writeln("#include \"core/str.hpp\"")
        }
        if used_core["sync"] || used_core["context"] {
            e.writeln("#include \"core/sync.hpp\"")
        }
        if used_core["time"] {
            e.writeln("#include \"core/time.hpp\"")
        }
        if used_core["unicode"] {
            e.writeln("#include \"core/unicode.hpp\"")
        }
    }
    mut chi: usize = 0
    n_ch := cpp_headers.len
    for chi < n_ch {
        ch := cpp_headers[chi]
        mut cdi: usize = 0
        n_cdef := ch.defines.len
        for cdi < n_cdef {
            e.writeln(ch.defines[cdi])
            cdi = cdi + 1
        }
        clean_path := clean_header_path(ch.path)
        e.writeln("#include <" + clean_path + ">")
        chi = chi + 1
    }
    if used_vendor.contains("raylib") {
        e.writeln("#include <raylib.h>")
    }
    e.writeln("")

    // 5. Emit interfaces
    mut ifi: usize = 0
    n_ifaces := cf.ast.interfaces.len
    for ifi < n_ifaces {
        iface_str := cpp::cfire::frontend::codegen_emit_interface(cf.ast.interfaces[ifi])
        e.write(iface_str)
        e.writeln("")
        ifi = ifi + 1
    }

    // 6. Forward declare all structs
    mut sdi: usize = 0
    n_structs := cf.ast.structs.len
    for sdi < n_structs {
        e.writeln("struct " + cf.ast.structs[sdi].name + ";")
        sdi = sdi + 1
    }
    if n_structs > 0 {
        e.writeln("")
    }

    // 7. Emit Structs & Enums in source declaration order
    mut items: []TypeDeclItem = []
    mut ei: usize = 0
    n_enums := cf.ast.enums.len
    for ei < n_enums {
        items.push(TypeDeclItem{
            line: cf.ast.enums[ei].line,
            is_enum: true,
            idx: ei,
        })
        ei = ei + 1
    }
    mut si: usize = 0
    for si < n_structs {
        items.push(TypeDeclItem{
            line: cf.ast.structs[si].line,
            is_enum: false,
            idx: si,
        })
        si = si + 1
    }

    // Stable insertion sort by line number
    mut sort_i: usize = 1
    n_items := items.len
    for sort_i < n_items {
        mut sort_j := sort_i
        for sort_j > 0 && items[sort_j - 1].line > items[sort_j].line {
            tmp := items[sort_j - 1]
            items[sort_j - 1] = items[sort_j]
            items[sort_j] = tmp
            sort_j = sort_j - 1
        }
        sort_i = sort_i + 1
    }

    mut item_i: usize = 0
    for item_i < n_items {
        it := items[item_i]
        if it.is_enum {
            en_str := cpp::cfire::frontend::codegen_emit_enum(cf.ast.enums[it.idx])
            e.write(en_str)
        } else {
            st_str := cpp::cfire::frontend::codegen_emit_struct(cf.ast.structs[it.idx], cf)
            e.write(st_str)
        }
        e.writeln("")
        item_i = item_i + 1
    }

    // 8. Emit Global / Package-level Variables
    mut gvi: usize = 0
    n_gvs := cf.ast.global_vars.len
    for gvi < n_gvs {
        gv_str := cpp::cfire::frontend::codegen_emit_global_var(cf.ast.global_vars[gvi], cf)
        e.write(gv_str)
        gvi = gvi + 1
    }
    if n_gvs > 0 {
        e.writeln("")
    }

    // 9. Forward Declarations for Functions & Receiver Methods
    mut ffi: usize = 0
    n_fns := cf.ast.functions.len
    for ffi < n_fns {
        fn_fwd := cpp::cfire::frontend::codegen_emit_fn_forward_decl(cf.ast.functions[ffi])
        e.write(fn_fwd)
        ffi = ffi + 1
    }
    if n_fns > 0 {
        e.writeln("")
    }

    // 10. Emit Functions & Receiver Methods
    mut has_user_main := false
    mut fi: usize = 0
    for fi < n_fns {
        fn_decl := cf.ast.functions[fi]
        has_receiver := cpp::cfire::frontend::ast_fn_has_receiver(cf.ast, fi)
        if fn_decl.name == "main" && !has_receiver {
            has_user_main = true
            if e.test_mode {
                fi = fi + 1
                continue
            }
        }
        fn_str := cpp::cfire::frontend::codegen_emit_function(fn_decl, cf)
        e.write(fn_str)
        if fi + 1 < n_fns || cf.ast.tests.len > 0 {
            e.writeln("")
        }
        fi = fi + 1
    }

    // 11. Emit `test "..." { ... }` Blocks & Test Harness Runner
    mut ti: usize = 0
    n_tests := cf.ast.tests.len
    for ti < n_tests {
        td_str := cpp::cfire::frontend::codegen_emit_test_decl(cf.ast.tests[ti], ti, cf)
        e.write(td_str)
        e.writeln("")
        ti = ti + 1
    }
    if (e.test_mode || !has_user_main) && n_tests > 0 {
        e.writeln("auto main() -> int {")
        e.indent_level = e.indent_level + 1
        mut ri: usize = 0
        for ri < n_tests {
            t_name := cf.ast.tests[ri].name
            e.writeln("std::println(\"=== RUN   " + t_name + "\");")
            e.writeln("__cfire_test_" + cpp::cfire::frontend::codegen_usize_to_str(ri) + "();")
            e.writeln("std::println(\"--- PASS: " + t_name + "\");")
            ri = ri + 1
        }
        e.writeln("std::println(\"PASS (" + cpp::cfire::frontend::codegen_usize_to_str(n_tests) + " cfire tests succeeded)\");")
        e.writeln("return 0;")
        e.indent_level = e.indent_level - 1
        e.writeln("}")
    }

    return e.buf
}

fn selfhost_emit_cpp_file(cf: cpp::cfire::frontend::CheckedFile, test_mode: bool) -> str {
    mut emitter := CodegenEmitter{
        buf: "",
        indent_level: 0,
        test_mode: test_mode,
    }
    return emitter.emit_file(cf)
}
