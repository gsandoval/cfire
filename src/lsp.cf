package lsp
// src/lsp.cf — Language Server Protocol (LSP 3.17) Frame & Protocol Generator
// Self-hosted in pure cfire with 100% byte-for-byte protocol parity.

fn lsp_json_escape(s: str) -> str {
    mut res: str = ""
    mut start: usize = 0
    mut i: usize = 0
    n := s.len
    for i < n {
        c := s[i]
        if c == 34 || c == 92 || c == 10 || c == 13 || c == 9 { // '"', '\\', '\n', '\r', '\t'
            if i > start {
                res += s[start..i]
            }
            if c == 34 {
                res += "\\\""
            } else if c == 92 {
                res += "\\\\"
            } else if c == 10 {
                res += "\\n"
            } else if c == 13 {
                res += "\\r"
            } else if c == 9 {
                res += "\\t"
            }
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        res += s[start..n]
    }
    return res
}

fn lsp_json_unescape(s: str) -> str {
    mut res: str = ""
    mut start: usize = 0
    mut i: usize = 0
    n := s.len
    for i < n {
        if s[i] == 92 && i + 1 < n { // '\\'
            if i > start {
                res += s[start..i]
            }
            next := s[i + 1]
            if next == 110 { // 'n'
                res += "\n"
            } else if next == 114 { // 'r'
                res += "\r"
            } else if next == 116 { // 't'
                res += "\t"
            } else if next == 34 { // '"'
                res += "\""
            } else if next == 92 { // '\\'
                res += "\\"
            } else if next == 47 { // '/'
                res += "/"
            } else {
                res += s[i + 1..i + 2]
            }
            i = i + 2
            start = i
        } else {
            i = i + 1
        }
    }
    if start < n {
        res += s[start..n]
    }
    return res
}

fn selfhost_make_rpc_frame(body: str) -> str {
    return "Content-Length: " + cpp::cfire::frontend::codegen_usize_to_str(body.len) + "\r\n\r\n" + body
}

fn selfhost_make_rpc_response(id: str, result_json: str) -> str {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":" + result_json + "}"
}

fn selfhost_make_rpc_notification(method: str, params_json: str) -> str {
    return "{\"jsonrpc\":\"2.0\",\"method\":\"" + method + "\",\"params\":" + params_json + "}"
}

fn selfhost_make_rpc_error(id: str, code: i32, message: str) -> str {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":" + cpp::cfire::frontend::codegen_to_str(code) + ",\"message\":\"" + lsp_json_escape(message) + "\"}}"
}

fn selfhost_format_hover_markdown(id: str, markdown_content: str) -> str {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"" + lsp_json_escape(markdown_content) + "\"}}}"
}

fn selfhost_format_null_response(id: str) -> str {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}"
}

fn selfhost_format_completion_list(id: str, items_json: str) -> str {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"isIncomplete\":false,\"items\":" + items_json + "}}"
}

fn selfhost_format_publish_diagnostics(uri: str, diagnostics_json: str) -> str {
    return "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"" + uri + "\",\"diagnostics\":" + diagnostics_json + "}}"
}

fn selfhost_format_initialize_response(id: str) -> str {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"definitionProvider\":true,\"typeDefinitionProvider\":true,\"referencesProvider\":true,\"renameProvider\":{\"prepareProvider\":true},\"codeActionProvider\":true,\"documentFormattingProvider\":true,\"documentRangeFormattingProvider\":true,\"documentSymbolProvider\":true,\"workspaceSymbolProvider\":true,\"inlayHintProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\",\":\",\"@\"]},\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]},\"semanticTokensProvider\":{\"legend\":{\"tokenTypes\":[\"type\",\"struct\",\"enum\",\"interface\",\"parameter\",\"variable\",\"property\",\"enumMember\",\"function\",\"method\",\"keyword\",\"modifier\",\"string\",\"number\",\"operator\",\"namespace\"],\"tokenModifiers\":[\"declaration\",\"definition\",\"readonly\",\"modification\",\"defaultLibrary\",\"async\"]},\"full\":true}}},\"serverInfo\":{\"name\":\"cfire-lsp\",\"version\":\"1.3.0\"}}}"
}
