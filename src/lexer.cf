package frontend

import cpp "lexer_types.hpp"


// selfhost_tokenize: Core Tokenizer for cfire (.cf) written in cfire itself
fn selfhost_tokenize(file: &str, src: &str) -> []cpp::cfire::frontend::Token! {
    mut tokens: []cpp::cfire::frontend::Token = []
    mut i: usize = 0
    n := src.len
    mut line: i32 = 1
    mut col: i32 = 1

    for i < n {
        c := src[i]

        // 1. Whitespace
        if c == 32 || c == 9 || c == 13 || c == 11 || c == 12 {
            i = i + 1
            col = col + 1
            continue
        }
        if c == 10 { // '\n'
            i = i + 1
            line = line + 1
            col = 1
            continue
        }

        // 2. Line Comments (`//...`)
        if c == 47 && i + 1 < n && src[i + 1] == 47 {
            for i < n && src[i] != 10 {
                i = i + 1
            }
            continue
        }

        start_line := line
        start_col := col

        // 3. Identifiers & Keywords
        if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 {
            start_i := i
            for i < n {
                mut ch := src[i]
                if (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || (ch >= 48 && ch <= 57) || ch == 95 {
                    i = i + 1
                    col = col + 1
                } else {
                    break
                }
            }
            word := src[start_i..i]

            // Special case: `cpp { ... }` balanced block
            if word == "cpp" {
                mut probe := i
                for probe < n && (src[probe] == 32 || src[probe] == 9 || src[probe] == 10 || src[probe] == 13) {
                    probe = probe + 1
                }
                if probe < n && src[probe] == 123 { // '{'
                    for i < probe {
                        if src[i] == 10 {
                            line = line + 1
                            col = 1
                        } else {
                            col = col + 1
                        }
                        i = i + 1
                    }
                    i = i + 1 // skip '{'
                    col = col + 1
                    mut depth: i32 = 1
                    start_cpp := i
                    for i < n && depth > 0 {
                        ch := src[i]
                        if ch == 10 {
                            line = line + 1
                            col = 1
                        } else {
                            col = col + 1
                        }
                        i = i + 1
                        if ch == 123 {
                            depth = depth + 1
                        } else if ch == 125 {
                            depth = depth - 1
                            if depth == 0 {
                                break
                            }
                        }
                    }
                    cpp_slice := src[start_cpp..(i - 1)]
                    tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::CppBlock, cpp_slice, start_line, start_col))
                    continue
                }

                tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::KwCpp, word, start_line, start_col))
                continue
            }

            kw_opt := cpp::cfire::frontend::find_keyword(word)
            if kw_opt.has_value() {
                tokens.push(cpp::cfire::frontend::make_tok(*kw_opt, word, start_line, start_col))
            } else {
                tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::Ident, word, start_line, start_col))
            }
            continue
        }

        // 4. Numbers (stop before '..' range operator)
        if c >= 48 && c <= 57 {
            mut is_float := false
            mut num_str := ""
            for i < n {
                ch := src[i]
                if (ch >= 48 && ch <= 57) || ch == 95 {
                    if ch != 95 {
                        num_str = num_str + src[i..i + 1]
                    }
                    i = i + 1
                    col = col + 1
                } else if ch == 46 { // '.'
                    if i + 1 < n && src[i + 1] == 46 {
                        break // stop before '..' range operator
                    }
                    is_float = true
                    num_str = num_str + src[i..i + 1]
                    i = i + 1
                    col = col + 1
                } else {
                    break
                }
            }

            mut tok_kind := cpp::cfire::frontend::TokenKind::Int
            if is_float {
                tok_kind = cpp::cfire::frontend::TokenKind::Float
            }
            tokens.push(cpp::cfire::frontend::make_tok(tok_kind, num_str, start_line, start_col))
            continue
        }

        // 5. Double-quoted String
        if c == 34 { // '"'
            i = i + 1
            col = col + 1
            mut s := ""
            mut unterminated := true
            for i < n {
                mut ch := src[i]
                if ch == 34 { // closing '"'
                    i = i + 1
                    col = col + 1
                    unterminated = false
                    break
                }
                if ch == 92 { // escape '\\'
                    s = s + "\\"
                    if ch == 10 {
                        line = line + 1
                        col = 1
                    } else {
                        col = col + 1
                    }
                    i = i + 1
                    if i >= n {
                        break
                    }
                    ch = src[i]
                }
                s = s + src[i..i + 1]
                if ch == 10 {
                    line = line + 1
                    col = 1
                } else {
                    col = col + 1
                }
                i = i + 1
            }

            if unterminated {
                err_msg := "{file}:{start_line}:{start_col}: unterminated string literal"
                return cpp::std::unexpected(err_msg)
            }

            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::String, s, start_line, start_col))
            continue
        }

        // 6. Backtick Raw String / Struct Tag
        if c == 96 { // '`'
            i = i + 1
            col = col + 1
            start_raw := i
            mut unterminated := true
            for i < n {
                ch := src[i]
                if ch == 96 { // closing '`'
                    unterminated = false
                    break
                }
                if ch == 10 {
                    line = line + 1
                    col = 1
                } else {
                    col = col + 1
                }
                i = i + 1
            }

            if unterminated {
                err_msg := "{file}:{start_line}:{start_col}: unterminated raw string literal"
                return cpp::std::unexpected(err_msg)
            }

            raw_slice := src[start_raw..i]
            i = i + 1 // skip closing '`'
            col = col + 1
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::RawString, raw_slice, start_line, start_col))
            continue
        }

        // 7. Two-character operators
        if i + 1 < n {
            c2 := src[i + 1]
            if c == 46 && c2 == 46 { // ".."
                i = i + 2
                col = col + 2
                tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::DotDot, "..", start_line, start_col))
                continue
            }
            if c == 61 && c2 == 62 { // "=>"
                i = i + 2
                col = col + 2
                tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::FatArrow, "=>", start_line, start_col))
                continue
            }
            if c == 58 && c2 == 61 { // ":="
                i = i + 2
                col = col + 2
                tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::ColonEq, ":=", start_line, start_col))
                continue
            }
            if c == 58 && c2 == 58 { // "::"
                i = i + 2
                col = col + 2
                tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::DoubleColon, "::", start_line, start_col))
                continue
            }
            if c == 45 && c2 == 62 { // "->"
                i = i + 2
                col = col + 2
                tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::Arrow, "->", start_line, start_col))
                continue
            }
            if c == 43 && c2 == 61 { // "+="
                i = i + 2
                col = col + 2
                tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::PlusEq, "+=", start_line, start_col))
                continue
            }
            if c == 45 && c2 == 61 { // "-="
                i = i + 2
                col = col + 2
                tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::MinusEq, "-=", start_line, start_col))
                continue
            }
            if c == 61 && c2 == 61 { // "=="
                i = i + 2
                col = col + 2
                tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::Eq, "==", start_line, start_col))
                continue
            }
            if c == 33 && c2 == 61 { // "!="
                i = i + 2
                col = col + 2
                tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::Neq, "!=", start_line, start_col))
                continue
            }
            if c == 60 && c2 == 61 { // "<="
                i = i + 2
                col = col + 2
                tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::Le, "<=", start_line, start_col))
                continue
            }
            if c == 62 && c2 == 61 { // ">="
                i = i + 2
                col = col + 2
                tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::Ge, ">=", start_line, start_col))
                continue
            }
            if c == 38 && c2 == 38 { // "&&"
                i = i + 2
                col = col + 2
                tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::DoubleAmp, "&&", start_line, start_col))
                continue
            }
            if c == 124 && c2 == 124 { // "||"
                i = i + 2
                col = col + 2
                tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::DoublePipe, "||", start_line, start_col))
                continue
            }
        }

        // 8. Single-character symbols
        i = i + 1
        col = col + 1

        if c == 40 { // '('
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::LParen, "(", start_line, start_col))
            continue
        }
        if c == 41 { // ')'
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::RParen, ")", start_line, start_col))
            continue
        }
        if c == 123 { // '{'
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::LBrace, "{", start_line, start_col))
            continue
        }
        if c == 125 { // '}'
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::RBrace, "}", start_line, start_col))
            continue
        }
        if c == 91 { // '['
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::LBracket, "[", start_line, start_col))
            continue
        }
        if c == 93 { // ']'
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::RBracket, "]", start_line, start_col))
            continue
        }
        if c == 58 { // ':'
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::Colon, ":", start_line, start_col))
            continue
        }
        if c == 44 { // ','
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::Comma, ",", start_line, start_col))
            continue
        }
        if c == 46 { // '.'
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::Dot, ".", start_line, start_col))
            continue
        }
        if c == 61 { // '='
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::Assign, "=", start_line, start_col))
            continue
        }
        if c == 43 { // '+'
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::Plus, "+", start_line, start_col))
            continue
        }
        if c == 45 { // '-'
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::Minus, "-", start_line, start_col))
            continue
        }
        if c == 42 { // '*'
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::Star, "*", start_line, start_col))
            continue
        }
        if c == 47 { // '/'
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::Slash, "/", start_line, start_col))
            continue
        }
        if c == 37 { // '%'
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::Percent, "%", start_line, start_col))
            continue
        }
        if c == 38 { // '&'
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::Amp, "&", start_line, start_col))
            continue
        }
        if c == 124 { // '|'
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::Pipe, "|", start_line, start_col))
            continue
        }
        if c == 33 { // '!'
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::Bang, "!", start_line, start_col))
            continue
        }
        if c == 63 { // '?'
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::Question, "?", start_line, start_col))
            continue
        }
        if c == 64 { // '@'
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::At, "@", start_line, start_col))
            continue
        }
        if c == 60 { // '<'
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::Lt, "<", start_line, start_col))
            continue
        }
        if c == 62 { // '>'
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::Gt, ">", start_line, start_col))
            continue
        }
        if c == 59 { // ';'
            tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::Semicolon, ";", start_line, start_col))
            continue
        }

        // 9. Unexpected character error
        bad_char := src[(i - 1)..i]
        err_msg := "{file}:{start_line}:{start_col}: unexpected character '{bad_char}'"
        return cpp::std::unexpected(err_msg)
    }

    tokens.push(cpp::cfire::frontend::make_tok(cpp::cfire::frontend::TokenKind::Eof, "", line, col))
    return tokens
}
