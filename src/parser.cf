package frontend

import cpp "lexer_types.hpp"
import cpp "ast.hpp"

// src/parser.cf — Recursive-Descent & Pratt Expression Parser for cfire (.cf)
// Self-hosted in pure cfire, compiling cfire syntax trees directly.

// --- Helper Integer Formatter ---

fn parser_usize_to_str(val: usize) -> str {
    if (val == 0) {
        return "0"
    }
    mut v := val
    mut digits: str = ""
    for (v > 0) {
        d := v % 10
        if (d == 0) {
            digits = "0" + digits
        }
        else if (d == 1) { digits = "1" + digits }
        else if (d == 2) { digits = "2" + digits }
        else if (d == 3) { digits = "3" + digits }
        else if (d == 4) { digits = "4" + digits }
        else if (d == 5) { digits = "5" + digits }
        else if (d == 6) { digits = "6" + digits }
        else if (d == 7) { digits = "7" + digits }
        else if (d == 8) { digits = "8" + digits }
        else { digits = "9" + digits }
        v = v / 10
    }
    return digits
}

fn parser_i32_to_str(val: i32) -> str {
    if (val <= 0) {
        return "0"
    }
    mut v := val
    mut digits: str = ""
    for (v > 0) {
        d := v % 10
        if (d == 0) {
            digits = "0" + digits
        }
        else if (d == 1) { digits = "1" + digits }
        else if (d == 2) { digits = "2" + digits }
        else if (d == 3) { digits = "3" + digits }
        else if (d == 4) { digits = "4" + digits }
        else if (d == 5) { digits = "5" + digits }
        else if (d == 6) { digits = "6" + digits }
        else if (d == 7) { digits = "7" + digits }
        else if (d == 8) { digits = "8" + digits }
        else { digits = "9" + digits }
        v = v / 10
    }
    return digits
}

// --- Precedence Classifier ---

fn get_binary_precedence(k: cpp::cfire::frontend::TokenKind) -> i32 {
    if (k == cpp::cfire::frontend::TokenKind::DoublePipe){
        return 1
    }
    if (k == cpp::cfire::frontend::TokenKind::DoubleAmp){
        return 2
    }
    if (k == cpp::cfire::frontend::TokenKind::Pipe){
        return 3
    }
    if (k == cpp::cfire::frontend::TokenKind::Amp){
        return 4
    }
    if (k == cpp::cfire::frontend::TokenKind::Eq || k == cpp::cfire::frontend::TokenKind::Neq){
        return 5
    }
    if (k == cpp::cfire::frontend::TokenKind::Lt || k == cpp::cfire::frontend::TokenKind::Gt ||
       k == cpp::cfire::frontend::TokenKind::Le || k == cpp::cfire::frontend::TokenKind::Ge) {
        return 6
    }
    if (k == cpp::cfire::frontend::TokenKind::Plus || k == cpp::cfire::frontend::TokenKind::Minus) {
        return 7
    }
    if (k == cpp::cfire::frontend::TokenKind::Star || k == cpp::cfire::frontend::TokenKind::Slash ||
       k == cpp::cfire::frontend::TokenKind::Percent) {
        return 8
    }
    return 0
}

// --- Core Parser State ---

type SelfhostParser struct {
    file: str
    tokens: []cpp::cfire::frontend::Token
    pos: usize
    errors: []str
    resilient: bool
}

fn make_parser(file: &str, tokens: []cpp::cfire::frontend::Token, resilient: bool) -> SelfhostParser {
    return SelfhostParser{
        file: "" + file,
        tokens: tokens,
        pos: 0,
        errors: [],
        resilient: resilient,
    }
}

// --- Navigation & Error Reporting ---

fn (p: SelfhostParser) cur() -> cpp::cfire::frontend::Token {
    if (p.pos < p.tokens.len) {
        return p.tokens[p.pos]
    }
    return p.tokens[p.tokens.len - 1]
}

fn (p: SelfhostParser) peek(offset: usize) -> cpp::cfire::frontend::Token {
    idx := p.pos + offset
    if (idx < p.tokens.len) {
        return p.tokens[idx]
    }
    return p.tokens[p.tokens.len - 1]
}

fn (mut p: SelfhostParser) advance() -> cpp::cfire::frontend::Token {
    t := p.cur()
    if (p.pos + 1 < p.tokens.len) {
        p.pos = p.pos + 1
    }
    return t
}

fn (mut p: SelfhostParser) record_error(err: str) {
    if (p.errors.len < 20) {
        p.errors.push(err)
    }
}

fn (mut p: SelfhostParser) expect(kind: cpp::cfire::frontend::TokenKind) -> (cpp::cfire::frontend::Token, bool) {
    t := p.cur()
    if (t.kind != kind) {
        err := p.file + ":" + parser_i32_to_str(t.line) + ":" + parser_i32_to_str(t.col) + ": expected '" +
               cpp::cfire::frontend::token_kind_name(kind) + "', got '" + t.lexeme + "' (" +
               cpp::cfire::frontend::token_kind_name(t.kind) + ")"
        p.record_error(err)
        return (t, false)
    }
    return (p.advance(), true)
}

// --- Error Recovery & Synchronization ---

fn (mut p: SelfhostParser) synchronize_decl() {
    if (p.cur().kind != cpp::cfire::frontend::TokenKind::Eof){
        p.advance()
    }
    for (p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
        k := p.cur().kind
        if (k == cpp::cfire::frontend::TokenKind::KwPackage ||
           k == cpp::cfire::frontend::TokenKind::KwImport ||
           k == cpp::cfire::frontend::TokenKind::KwType ||
           k == cpp::cfire::frontend::TokenKind::KwFn ||
           k == cpp::cfire::frontend::TokenKind::KwVar ||
           k == cpp::cfire::frontend::TokenKind::KwMut ||
           k == cpp::cfire::frontend::TokenKind::KwTest) {
            return
        }
        if (k == cpp::cfire::frontend::TokenKind::Ident){
            p1 := p.peek(1).kind
            if (p1 == cpp::cfire::frontend::TokenKind::ColonEq || p1 == cpp::cfire::frontend::TokenKind::Colon){
                return
        }
            p.advance()
        } else {
            p.advance()
        }
    }
}

fn (mut p: SelfhostParser) synchronize_stmt() {
    if (p.cur().kind == cpp::cfire::frontend::TokenKind::Semicolon){
        p.advance()
        return
    }
    if (p.cur().kind != cpp::cfire::frontend::TokenKind::Eof && p.cur().kind != cpp::cfire::frontend::TokenKind::RBrace){
        p.advance()
    }
    for (p.cur().kind != cpp::cfire::frontend::TokenKind::Eof && p.cur().kind != cpp::cfire::frontend::TokenKind::RBrace) {
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::Semicolon){
            p.advance()
            return
        }
        k := p.cur().kind
        if (k == cpp::cfire::frontend::TokenKind::KwReturn ||
           k == cpp::cfire::frontend::TokenKind::KwIf ||
           k == cpp::cfire::frontend::TokenKind::KwFor ||
           k == cpp::cfire::frontend::TokenKind::KwMatch ||
           k == cpp::cfire::frontend::TokenKind::KwVar ||
           k == cpp::cfire::frontend::TokenKind::KwMut ||
           k == cpp::cfire::frontend::TokenKind::KwDefer ||
           k == cpp::cfire::frontend::TokenKind::CppBlock ||
           k == cpp::cfire::frontend::TokenKind::KwAsync) {
            return
        }
        if (k == cpp::cfire::frontend::TokenKind::Ident){
            p1 := p.peek(1).kind
            if (p1 == cpp::cfire::frontend::TokenKind::ColonEq || p1 == cpp::cfire::frontend::TokenKind::Colon ||
                p1 == cpp::cfire::frontend::TokenKind::Assign || p1 == cpp::cfire::frontend::TokenKind::PlusEq ||
                p1 == cpp::cfire::frontend::TokenKind::MinusEq) {
                return
        }
        }
        if (k == cpp::cfire::frontend::TokenKind::KwFn ||
           k == cpp::cfire::frontend::TokenKind::KwType ||
           k == cpp::cfire::frontend::TokenKind::KwTest ||
           k == cpp::cfire::frontend::TokenKind::KwImport) {
            return
        }
        p.advance()
    }
}

// --- Lookaheads ---

fn (p: SelfhostParser) is_generic_call_lookahead() -> bool {
    if (p.cur().kind != cpp::cfire::frontend::TokenKind::LBracket){
        return false
    }
    mut depth: i32 = 0
    mut i := p.pos
    n := p.tokens.len
    for (i < n) {
        k := p.tokens[i].kind
        if (k == cpp::cfire::frontend::TokenKind::LBracket){
            depth = depth + 1
        } else if (k == cpp::cfire::frontend::TokenKind::RBracket) {
            depth = depth - 1
            if (depth == 0) {
                return (i + 1 < n && p.tokens[i + 1].kind == cpp::cfire::frontend::TokenKind::LParen)
            }
        } else if (k == cpp::cfire::frontend::TokenKind::Semicolon || k == cpp::cfire::frontend::TokenKind::Eof || k == cpp::cfire::frontend::TokenKind::RBrace) {
            break
        }
        i = i + 1
    }
    return false
}

fn (p: SelfhostParser) is_destructure_lookahead(offset: usize) -> (bool, bool) {
    start := p.pos + offset
    n := p.tokens.len
    if (start >= n || p.tokens[start].kind != cpp::cfire::frontend::TokenKind::LParen){
        return (false, false)
    }
    mut i := start + 1
    mut depth: i32 = 1
    for (i < n && depth > 0) {
        k := p.tokens[i].kind
        if (k == cpp::cfire::frontend::TokenKind::LParen){
            depth = depth + 1
        } else if (k == cpp::cfire::frontend::TokenKind::RParen) {
            depth = depth - 1
        } else if (k == cpp::cfire::frontend::TokenKind::Semicolon || k == cpp::cfire::frontend::TokenKind::Eof || k == cpp::cfire::frontend::TokenKind::RBrace) {
            return (false, false)
        }
        i = i + 1
    }
    if (depth == 0 && i < n) {
        if (p.tokens[i].kind == cpp::cfire::frontend::TokenKind::ColonEq){
            return (true, true)
    }
        if (p.tokens[i].kind == cpp::cfire::frontend::TokenKind::Assign){
            return (true, false)
        }
    }
    return (false, false)
}

// --- Type Reference Parser ---

fn (mut p: SelfhostParser) parse_type_ref() -> (cpp::cfire::frontend::TypeRef, bool) {
    mut tr := cpp::cfire::frontend::TypeRef{}
    if (p.cur().kind == cpp::cfire::frontend::TokenKind::Amp){
        p.advance()
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwMut){
            p.advance()
            tr.is_mut_borrow = true
    } else {
            tr.is_borrow = true
        }
        (inner, ok_in) := p.parse_type_ref()
        if (!ok_in) {
            return (tr, false)
        }
        tr.name = inner.name
        tr.is_slice = inner.is_slice
        tr.is_array = inner.is_array
        tr.array_len = inner.array_len
        tr.is_map = inner.is_map
        tr.key_type = inner.key_type
        if (inner.elem_type != none) {
            tr.elem_type = inner.elem_type
        } else {
            tr.elem_type = cpp::std::make_shared[cpp::cfire::frontend::TypeRef](inner)
        }
    } else if (p.cur().kind == cpp::cfire::frontend::TokenKind::Star) {
        p.advance()
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwMut){
            p.advance()
            tr.is_mut_ptr = true
        } else {
            tr.is_ptr = true
        }
        (inner, ok_in) := p.parse_type_ref()
        if (!ok_in) {
            return (tr, false)
        }
        tr.name = inner.name
        tr.elem_type = cpp::std::make_shared[cpp::cfire::frontend::TypeRef](inner)
    } else if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwMap) {
        p.advance() // 'map'
        (tok_discard_1, ok_lb) := p.expect(cpp::cfire::frontend::TokenKind::LBracket)
        if (!ok_lb) {
            return (tr, false)
        }
        (ktype, ok_k) := p.parse_type_ref()
        if (!ok_k) {
            return (tr, false)
        }
        (tok_discard_2, ok_rb) := p.expect(cpp::cfire::frontend::TokenKind::RBracket)
        if (!ok_rb) {
            return (tr, false)
        }
        (vtype, ok_v) := p.parse_type_ref()
        if (!ok_v) {
            return (tr, false)
        }
        tr.is_map = true
        tr.name = "map[" + ktype.name + "]" + vtype.name
        tr.key_type = cpp::std::make_shared[cpp::cfire::frontend::TypeRef](ktype)
        tr.elem_type = cpp::std::make_shared[cpp::cfire::frontend::TypeRef](vtype)
    } else if (p.cur().kind == cpp::cfire::frontend::TokenKind::LBracket) {
        p.advance()
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::Int){
            len_str := p.advance().lexeme
            (tok_discard_3, ok_rb) := p.expect(cpp::cfire::frontend::TokenKind::RBracket)
            if (!ok_rb) { return (tr, false)
        }
            (elem, ok_el) := p.parse_type_ref()
            if (!ok_el) {
                return (tr, false)
            }
            tr.is_array = true
            tr.array_len = len_str
            tr.name = "[" + tr.array_len + "]" + elem.name
            tr.elem_type = cpp::std::make_shared[cpp::cfire::frontend::TypeRef](elem)
        } else {
            (tok_discard_4, ok_rb) := p.expect(cpp::cfire::frontend::TokenKind::RBracket)
            if (!ok_rb) {
                return (tr, false)
            }
            (elem, ok_el) := p.parse_type_ref()
            if (!ok_el) {
                return (tr, false)
            }
            tr.is_slice = true
            tr.name = "[]" + elem.name
            tr.elem_type = cpp::std::make_shared[cpp::cfire::frontend::TypeRef](elem)
        }
    } else if (p.cur().kind == cpp::cfire::frontend::TokenKind::LParen) {
        p.advance() // '('
        mut types: []cpp::cfire::frontend::TypeRef = []
        for (p.cur().kind != cpp::cfire::frontend::TokenKind::RParen && p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
            (t, ok_t) := p.parse_type_ref()
            if (!ok_t) {
                return (tr, false)
            }
            types.push(t)
            if (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma){
                p.advance()
            } else if (p.cur().kind != cpp::cfire::frontend::TokenKind::RParen) {
                err := p.file + ":" + parser_i32_to_str(p.cur().line) + ":" + parser_i32_to_str(p.cur().col) + ": expected ',' or ')' in tuple type"
                p.record_error(err)
                return (tr, false)
            }
        }
        (tok_discard_5, ok_rp) := p.expect(cpp::cfire::frontend::TokenKind::RParen)
        if (!ok_rp) {
            return (tr, false)
        }
        tr.is_tuple = true
        tr.tuple_types = types
        tr.name = "("
        mut i: usize = 0
        n := tr.tuple_types.len
        for (i < n) {
            if (i > 0) {
                tr.name = tr.name + ", "
            }
            tr.name = tr.name + tr.tuple_types[i].name
            i = i + 1
        }
        tr.name = tr.name + ")"
    } else {
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::Ident || p.cur().kind == cpp::cfire::frontend::TokenKind::KwCpp){
            tr.name = p.advance().lexeme
        } else {
            err := p.file + ":" + parser_i32_to_str(p.cur().line) + ":" + parser_i32_to_str(p.cur().col) + ": expected type name, got '" + p.cur().lexeme + "'"
            p.record_error(err)
            return (tr, false)
        }
        for (p.cur().kind == cpp::cfire::frontend::TokenKind::DoubleColon || p.cur().kind == cpp::cfire::frontend::TokenKind::Dot) {
            p.advance()
            (next_id, ok_next) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
            if (!ok_next) {
                return (tr, false)
            }
            tr.name = tr.name + "::" + next_id.lexeme
        }
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::LBracket){
            p.advance()
            (inner, ok_in) := p.parse_type_ref()
            if (!ok_in) { return (tr, false)
        }
            (tok_discard_6, ok_rb) := p.expect(cpp::cfire::frontend::TokenKind::RBracket)
            if (!ok_rb) {
                return (tr, false)
            }
            if (tr.name == "own" || tr.name == "shared") {
                tr.smart_wrap = tr.name
            }
            tr.elem_type = cpp::std::make_shared[cpp::cfire::frontend::TypeRef](inner)
        }
    }

    if (p.cur().kind == cpp::cfire::frontend::TokenKind::Question){
        p.advance()
        tr.is_optional = true
    }
    if (p.cur().kind == cpp::cfire::frontend::TokenKind::Bang){
        p.advance()
        tr.is_fallible = true
    }
    return (tr, true)
}

// --- Import Parser ---

fn (mut p: SelfhostParser) parse_import() -> (cpp::cfire::frontend::ImportDecl, bool) {
    start := p.advance() // 'import'
    mut imp := cpp::cfire::frontend::ImportDecl{}
    imp.line = start.line
    if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwCpp){
        p.advance()
        imp.is_cpp = true
    }
    (path_tok, ok_path) := p.expect(cpp::cfire::frontend::TokenKind::String)
    if (!ok_path) {
        return (imp, false)
    }
    imp.path = path_tok.lexeme

    if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwAs){
        p.advance()
        (alias_tok, ok_alias) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
        if (!ok_alias) { return (imp, false)
    }
        imp.alias = alias_tok.lexeme
    }

    for (p.cur().kind == cpp::cfire::frontend::TokenKind::At) {
        p.advance() // '@'
        (attr_name, ok_name) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
        if (!ok_name) {
            return (imp, false)
        }
        (tok_discard_7, ok_lp) := p.expect(cpp::cfire::frontend::TokenKind::LParen)
        if (!ok_lp) {
            return (imp, false)
        }
        mut attr := cpp::cfire::frontend::ImportAttr{}
        attr.name = attr_name.lexeme
        for (p.cur().kind != cpp::cfire::frontend::TokenKind::RParen && p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
            if (p.cur().kind == cpp::cfire::frontend::TokenKind::String || p.cur().kind == cpp::cfire::frontend::TokenKind::Ident){
                attr.args.push(p.advance().lexeme)
            } else {
                p.advance()
            }
            if (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma){
                p.advance()
            }
        }
        (tok_discard_8, ok_rp) := p.expect(cpp::cfire::frontend::TokenKind::RParen)
        if (!ok_rp) {
            return (imp, false)
        }
        imp.attrs.push(attr)
    }
    return (imp, true)
}

// --- Top-Level Declarations ---

fn (mut p: SelfhostParser) parse_type_decl(mut f: cpp::cfire::frontend::FileAST) -> bool {
    start := p.advance() // 'type'
    (name_tok, ok_name) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
    if (!ok_name) {
        return false
    }

    if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwStruct){
        p.advance() // 'struct'
        (tok_discard_9, ok_lb) := p.expect(cpp::cfire::frontend::TokenKind::LBrace)
        if (!ok_lb) { return false
    }
        mut st := cpp::cfire::frontend::StructDecl{}
        st.name = name_tok.lexeme
        st.line = start.line

        for (p.cur().kind != cpp::cfire::frontend::TokenKind::RBrace && p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
            (f_tok, ok_f) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
            if (!ok_f) {
                return false
            }
            if (p.cur().kind == cpp::cfire::frontend::TokenKind::Colon){
                p.advance()
            }
            (t_ref, ok_tr) := p.parse_type_ref()
            if (!ok_tr) {
                return false
            }

            mut field := cpp::cfire::frontend::StructField{}
            field.name = f_tok.lexeme
            field.type = t_ref
            field.line = f_tok.line

            if (p.cur().kind == cpp::cfire::frontend::TokenKind::Assign){
                p.advance()
                (def_val, ok_def) := p.parse_primary_expr()
                if (!ok_def) { return false
            }
                field.default_val = def_val
            }
            if (p.cur().kind == cpp::cfire::frontend::TokenKind::RawString){
                field.raw_tag = p.advance().lexeme
                // Tag regex parsing is automatically populated in C++ bridge
            }
            st.fields.push(field)
        }
        (tok_discard_10, ok_rb) := p.expect(cpp::cfire::frontend::TokenKind::RBrace)
        if (!ok_rb) {
            return false
        }
        f.structs.push(st)
        return true
    }

    if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwEnum){
        p.advance() // 'enum'
        (tok_discard_11, ok_lb) := p.expect(cpp::cfire::frontend::TokenKind::LBrace)
        if (!ok_lb) { return false
    }
        mut en := cpp::cfire::frontend::EnumDecl{}
        en.name = name_tok.lexeme
        en.line = start.line

        for (p.cur().kind != cpp::cfire::frontend::TokenKind::RBrace && p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
            (v_tok, ok_v) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
            if (!ok_v) {
                return false
            }
            mut v := cpp::cfire::frontend::EnumVariant{}
            v.name = v_tok.lexeme
            v.line = v_tok.line

            if (p.cur().kind == cpp::cfire::frontend::TokenKind::LParen){
                p.advance() // '('
                for (p.cur().kind != cpp::cfire::frontend::TokenKind::RParen && p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
                    if (p.cur().kind == cpp::cfire::frontend::TokenKind::Ident && p.peek(1).kind == cpp::cfire::frontend::TokenKind::Colon){
                        p.advance()
                        p.advance()
            }
                    (pt, ok_pt) := p.parse_type_ref()
                    if (!ok_pt) {
                        return false
                    }
                    v.payload_types.push(pt)
                    if (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma){
                        p.advance()
                    }
                }
                (tok_discard_12, ok_rp) := p.expect(cpp::cfire::frontend::TokenKind::RParen)
                if (!ok_rp) {
                    return false
                }
            }
            if (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma){
                p.advance()
            }
            en.variants.push(v)
        }
        (tok_discard_13, ok_rb) := p.expect(cpp::cfire::frontend::TokenKind::RBrace)
        if (!ok_rb) {
            return false
        }
        f.enums.push(en)
        return true
    }

    if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwInterface){
        p.advance() // 'interface'
        (tok_discard_14, ok_lb) := p.expect(cpp::cfire::frontend::TokenKind::LBrace)
        if (!ok_lb) { return false
    }
        mut iface := cpp::cfire::frontend::InterfaceDecl{}
        iface.name = name_tok.lexeme
        iface.line = start.line

        for (p.cur().kind != cpp::cfire::frontend::TokenKind::RBrace && p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
            if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwFn){
                p.advance()
        }
            (m_tok, ok_m) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
            if (!ok_m) {
                return false
            }
            (tok_discard_15, ok_lp) := p.expect(cpp::cfire::frontend::TokenKind::LParen)
            if (!ok_lp) {
                return false
            }
            mut sig := cpp::cfire::frontend::InterfaceMethodSig{}
            sig.name = m_tok.lexeme

            for (p.cur().kind != cpp::cfire::frontend::TokenKind::RParen && p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
                if (p.cur().kind == cpp::cfire::frontend::TokenKind::Ident && p.peek(1).kind == cpp::cfire::frontend::TokenKind::Colon){
                    p.advance()
                    p.advance()
                }
                (pt, ok_pt) := p.parse_type_ref()
                if (!ok_pt) {
                    return false
                }
                sig.param_types.push(pt)
                if (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma){
                    p.advance()
                }
            }
            (tok_discard_16, ok_rp) := p.expect(cpp::cfire::frontend::TokenKind::RParen)
            if (!ok_rp) {
                return false
            }
            if (p.cur().kind == cpp::cfire::frontend::TokenKind::Arrow){
                p.advance()
                (rt, ok_rt) := p.parse_type_ref()
                if (!ok_rt) { return false
            }
                sig.return_type = rt
                if (sig.return_type.is_slice && sig.return_type.elem_type != none && (*sig.return_type.elem_type).is_fallible) {
                    (*sig.return_type.elem_type).is_fallible = false
                    sig.return_type.is_fallible = true
                } else if (sig.return_type.is_slice && sig.return_type.elem_type != none && (*sig.return_type.elem_type).is_optional) {
                    (*sig.return_type.elem_type).is_optional = false
                    sig.return_type.is_optional = true
                }
            }
            iface.methods.push(sig)
        }
        (tok_discard_17, ok_rb) := p.expect(cpp::cfire::frontend::TokenKind::RBrace)
        if (!ok_rb) {
                return false
            }
        f.interfaces.push(iface)
        return true
    }

    err := p.file + ":" + parser_i32_to_str(p.cur().line) + ":" + parser_i32_to_str(p.cur().col) + ": expected 'struct', 'enum', or 'interface' after type name"
    p.record_error(err)
    return false
}

fn (mut p: SelfhostParser) parse_fn_decl() -> (cpp::cfire::frontend::FnDecl, bool) {
    start := p.advance() // 'fn'
    mut fn_decl := cpp::cfire::frontend::FnDecl{}
    fn_decl.return_type = cpp::cfire::frontend::TypeRef{name: "void"}
    fn_decl.line = start.line

    // Optional method receiver: `fn (s: Type)` or `fn (mut s: Type)`
    if (p.cur().kind == cpp::cfire::frontend::TokenKind::LParen){
        p.advance() // '('
        mut recv := cpp::cfire::frontend::ReceiverDecl{
    }
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwMut || p.cur().kind == cpp::cfire::frontend::TokenKind::KwIn){
            recv.intent = p.advance().lexeme
        }
        (r_name, ok_rn) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
        if (!ok_rn) {
            return (fn_decl, false)
        }
        recv.name = r_name.lexeme
        (tok_discard_18, ok_col) := p.expect(cpp::cfire::frontend::TokenKind::Colon)
        if (!ok_col) {
            return (fn_decl, false)
        }
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwMut){
            p.advance()
            recv.intent = "mut"
        }
        (r_type, ok_rt) := p.parse_type_ref()
        if (!ok_rt) {
            return (fn_decl, false)
        }
        recv.type = r_type
        (tok_discard_19, ok_rp) := p.expect(cpp::cfire::frontend::TokenKind::RParen)
        if (!ok_rp) {
            return (fn_decl, false)
        }
        fn_decl.receiver = recv
    }

    (name_tok, ok_name) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
    if (!ok_name) {
        return (fn_decl, false)
    }
    fn_decl.name = name_tok.lexeme

    // Optional generic type parameters: `fn foo[T: Hasher](...)`
    if (p.cur().kind == cpp::cfire::frontend::TokenKind::LBracket){
        p.advance() // '['
        for (p.cur().kind != cpp::cfire::frontend::TokenKind::RBracket && p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
            (tp_name, ok_tp) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
            if (!ok_tp) { return (fn_decl, false)
    }
            mut tp := cpp::cfire::frontend::TypeParam{name: tp_name.lexeme, constraint: ""}
            if (p.cur().kind == cpp::cfire::frontend::TokenKind::Colon){
                p.advance()
                (c_name, ok_c) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
                if (!ok_c) { return (fn_decl, false)
            }
                tp.constraint = c_name.lexeme
            }
            fn_decl.type_params.push(tp)
            if (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma){
                p.advance()
            }
        }
        (tok_discard_20, ok_rb) := p.expect(cpp::cfire::frontend::TokenKind::RBracket)
        if (!ok_rb) {
            return (fn_decl, false)
        }
    }

    (tok_discard_21, ok_lp) := p.expect(cpp::cfire::frontend::TokenKind::LParen)
    if (!ok_lp) {
        return (fn_decl, false)
    }

    for (p.cur().kind != cpp::cfire::frontend::TokenKind::RParen && p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
        mut intent: str = "in"
        k := p.cur().kind
        if (k == cpp::cfire::frontend::TokenKind::KwIn ||
            k == cpp::cfire::frontend::TokenKind::KwMut ||
            k == cpp::cfire::frontend::TokenKind::KwOut ||
            k == cpp::cfire::frontend::TokenKind::KwMove) {
            intent = p.advance().lexeme
        }
        (p_tok, ok_pt) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
        if (!ok_pt) {
            return (fn_decl, false)
        }
        (tok_discard_22, ok_col) := p.expect(cpp::cfire::frontend::TokenKind::Colon)
        if (!ok_col) {
            return (fn_decl, false)
        }
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwMut){
            p.advance()
            intent = "mut"
        }
        (t_ref, ok_tr) := p.parse_type_ref()
        if (!ok_tr) {
            return (fn_decl, false)
        }
        fn_decl.params.push(cpp::cfire::frontend::ParamDecl{
            intent: intent,
            name: p_tok.lexeme,
            type: t_ref,
            line: p_tok.line,
            col: p_tok.col,
        })
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma){
            p.advance()
        }
    }
    (tok_discard_23, ok_rp) := p.expect(cpp::cfire::frontend::TokenKind::RParen)
    if (!ok_rp) {
        return (fn_decl, false)
    }

    if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwAsync){
        p.advance()
        fn_decl.is_async = true
    }

    if (p.cur().kind == cpp::cfire::frontend::TokenKind::Arrow){
        p.advance()
        (ret, ok_ret) := p.parse_type_ref()
        if (!ok_ret) { return (fn_decl, false)
    }
        fn_decl.return_type = ret
        if (fn_decl.return_type.is_slice && fn_decl.return_type.elem_type != none && (*fn_decl.return_type.elem_type).is_fallible) {
            (*fn_decl.return_type.elem_type).is_fallible = false
            fn_decl.return_type.is_fallible = true
        } else if (fn_decl.return_type.is_slice && fn_decl.return_type.elem_type != none && (*fn_decl.return_type.elem_type).is_optional) {
            (*fn_decl.return_type.elem_type).is_optional = false
            fn_decl.return_type.is_optional = true
        }
    }

    (body, ok_body) := p.parse_block()
    if (!ok_body) {
        return (fn_decl, false)
    }
    fn_decl.body = body
    return (fn_decl, true)
}

fn (mut p: SelfhostParser) parse_global_var() -> (cpp::cfire::frontend::GlobalVarDecl, bool) {
    mut was_var := false
    mut is_mut := false
    line := p.cur().line
    mut gv := cpp::cfire::frontend::GlobalVarDecl{}

    if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwVar){
        p.advance() // 'var'
        was_var = true
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwMut){
            p.advance()
            is_mut = true
    }
    } else if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwMut) {
        p.advance() // 'mut'
        is_mut = true
    }

    (name_tok, ok_name) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
    if (!ok_name) {
        return (gv, false)
    }

    mut type_annot: cpp::cfire::frontend::TypeRef? = none
    if (p.cur().kind == cpp::cfire::frontend::TokenKind::Colon){
        p.advance() // ':'
        (tr, ok_tr) := p.parse_type_ref()
        if (!ok_tr) { return (gv, false)
    }
        type_annot = tr
    }

    if (p.cur().kind == cpp::cfire::frontend::TokenKind::ColonEq || p.cur().kind == cpp::cfire::frontend::TokenKind::Assign){
        p.advance() // ':=' or '='
    } else {
        err := p.file + ":" + parser_i32_to_str(p.cur().line) + ":" + parser_i32_to_str(p.cur().col) + ": expected ':=' or '=' in variable declaration"
        p.record_error(err)
        return (gv, false)
    }

    (val, ok_val) := p.parse_expr()
    if (!ok_val) {
        return (gv, false)
    }

    gv.name = name_tok.lexeme
    gv.is_mut = is_mut
    gv.type = type_annot
    gv.value = val
    gv.was_var = was_var
    gv.line = line
    return (gv, true)
}

fn (mut p: SelfhostParser) parse_test_decl() -> (cpp::cfire::frontend::TestDecl, bool) {
    start := p.advance() // 'test'
    mut td := cpp::cfire::frontend::TestDecl{}
    (name_tok, ok_name) := p.expect(cpp::cfire::frontend::TokenKind::String)
    if (!ok_name) {
        return (td, false)
    }
    (body, ok_body) := p.parse_block()
    if (!ok_body) {
        return (td, false)
    }
    td.name = name_tok.lexeme
    td.body = body
    td.line = start.line
    return (td, true)
}

// --- Block & Statement Parsing ---

fn (mut p: SelfhostParser) parse_block() -> ([]cpp::cfire::frontend::StmtPtr, bool) {
    mut stmts: []cpp::cfire::frontend::StmtPtr = []
    (tok_discard_24, ok_lb) := p.expect(cpp::cfire::frontend::TokenKind::LBrace)
    if (!ok_lb) {
        return (stmts, false)
    }

    for (p.cur().kind != cpp::cfire::frontend::TokenKind::RBrace && p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::Semicolon){
            p.advance()
            continue
        }
        (st, ok_st) := p.parse_stmt()
        if (!ok_st) {
            if (!p.resilient) { return (stmts, false)
        }
            p.synchronize_stmt()
        } else {
            stmts.push(st)
        }
        for (p.cur().kind == cpp::cfire::frontend::TokenKind::Semicolon) {
            p.advance()
        }
    }

    if (p.cur().kind == cpp::cfire::frontend::TokenKind::RBrace){
        p.advance()
    } else if (!p.resilient) {
        (tok_discard_25, ok_rb) := p.expect(cpp::cfire::frontend::TokenKind::RBrace)
        if (!ok_rb) {
            return (stmts, false)
        }
    } else {
        err := p.file + ":" + parser_i32_to_str(p.cur().line) + ":" + parser_i32_to_str(p.cur().col) + ": expected '}' at end of block"
        p.record_error(err)
    }
    return (stmts, true)
}

fn (mut p: SelfhostParser) parse_stmt() -> (cpp::cfire::frontend::StmtPtr, bool) {
    tok := p.cur()
    if (tok.kind == cpp::cfire::frontend::TokenKind::CppBlock){
        p.advance()
        return (cpp::cfire::frontend::make_stmt(cpp::cfire::frontend::CppBlockStmt{raw_code: tok.lexeme, line: tok.line
    }, tok.line), true)
    }
    if (tok.kind == cpp::cfire::frontend::TokenKind::KwDefer){
        p.advance()
        (call, ok_call) := p.parse_expr()
        if (!ok_call) { return (cpp::cfire::frontend::StmtPtr{
    }, false) }
        return (cpp::cfire::frontend::make_stmt(cpp::cfire::frontend::DeferStmt{call: call, line: tok.line}, tok.line), true)
    }
    if (tok.kind == cpp::cfire::frontend::TokenKind::KwReturn){
        p.advance()
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::RBrace){
            return (cpp::cfire::frontend::make_stmt(cpp::cfire::frontend::ReturnStmt{value: cpp::cfire::frontend::ExprPtr{
    }, line: tok.line}, tok.line), true)
        }
        (val, ok_val) := p.parse_expr()
        if (!ok_val) {
            return (cpp::cfire::frontend::StmtPtr{
        }, false) }
        return (cpp::cfire::frontend::make_stmt(cpp::cfire::frontend::ReturnStmt{value: val, line: tok.line}, tok.line), true)
    }
    if (tok.kind == cpp::cfire::frontend::TokenKind::KwIf){
        return p.parse_if_stmt()
    }
    if (tok.kind == cpp::cfire::frontend::TokenKind::KwFor){
        return p.parse_for_stmt()
    }
    if (tok.kind == cpp::cfire::frontend::TokenKind::KwMatch){
        return p.parse_match_stmt()
    }
    if (tok.kind == cpp::cfire::frontend::TokenKind::KwVar){
        p.advance()
        mut is_mut := false
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwMut){
            p.advance()
            is_mut = true
    }
        (id_tok, ok_id) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
        if (!ok_id) {
            return (cpp::cfire::frontend::StmtPtr{
        }, false) }
        mut t_ref: cpp::cfire::frontend::TypeRef? = none
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::Colon){
            p.advance()
            (tr, ok_tr) := p.parse_type_ref()
            if (!ok_tr) { return (cpp::cfire::frontend::StmtPtr{
        }, false) }
            t_ref = tr
        }
        mut init := cpp::cfire::frontend::ExprPtr{}
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::Assign || p.cur().kind == cpp::cfire::frontend::TokenKind::ColonEq){
            p.advance()
            (ex, ok_ex) := p.parse_expr()
            if (!ok_ex) { return (cpp::cfire::frontend::StmtPtr{
        }, false) }
            init = ex
        }
        return (cpp::cfire::frontend::make_stmt(cpp::cfire::frontend::VarDeclStmt{
            name: id_tok.lexeme,
            is_mut: is_mut,
            type: t_ref,
            init: init,
            was_var: true,
            line: id_tok.line,
            col: id_tok.col,
        }, id_tok.line), true)
    }
    if (tok.kind == cpp::cfire::frontend::TokenKind::KwMut){
        p.advance()
        (id_tok, ok_id) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
        if (!ok_id) { return (cpp::cfire::frontend::StmtPtr{
    }, false) }
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::Colon){
            p.advance()
            (t_ref, ok_tr) := p.parse_type_ref()
            if (!ok_tr) { return (cpp::cfire::frontend::StmtPtr{
        }, false) }
            mut init := cpp::cfire::frontend::ExprPtr{}
            if (p.cur().kind == cpp::cfire::frontend::TokenKind::Assign){
                p.advance()
                (ex, ok_ex) := p.parse_expr()
                if (!ok_ex) { return (cpp::cfire::frontend::StmtPtr{
            }, false) }
                init = ex
            }
            return (cpp::cfire::frontend::make_stmt(cpp::cfire::frontend::VarDeclStmt{
                name: id_tok.lexeme,
                is_mut: true,
                type: t_ref,
                init: init,
                was_var: false,
                line: id_tok.line,
                col: id_tok.col,
            }, id_tok.line), true)
        }
        (tok_discard_26, ok_ce) := p.expect(cpp::cfire::frontend::TokenKind::ColonEq)
        if (!ok_ce) {
            return (cpp::cfire::frontend::StmtPtr{
        }, false) }
        (init, ok_in) := p.parse_expr()
        if (!ok_in) {
            return (cpp::cfire::frontend::StmtPtr{
        }, false) }
        return (cpp::cfire::frontend::make_stmt(cpp::cfire::frontend::VarDeclStmt{
            name: id_tok.lexeme,
            is_mut: true,
            type: none,
            init: init,
            was_var: false,
            line: id_tok.line,
            col: id_tok.col,
        }, id_tok.line), true)
    }
    if (tok.kind == cpp::cfire::frontend::TokenKind::KwAsync){
        p.advance()
        (tok_discard_27, ok_dot) := p.expect(cpp::cfire::frontend::TokenKind::Dot)
        if (!ok_dot) { return (cpp::cfire::frontend::StmtPtr{
    }, false) }
        (m, ok_m) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
        if (!ok_m || m.lexeme != "scope") {
            err := p.file + ":" + parser_i32_to_str(tok.line) + ":" + parser_i32_to_str(tok.col) + ": expected async.scope"
            p.record_error(err)
            return (cpp::cfire::frontend::StmtPtr{
        }, false)
        }
        (tok_discard_28, ok_lp) := p.expect(cpp::cfire::frontend::TokenKind::LParen)
        if (!ok_lp) {
            return (cpp::cfire::frontend::StmtPtr{
        }, false) }
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::Ident && p.peek(1).kind == cpp::cfire::frontend::TokenKind::Colon){
            p.advance()
            p.advance()
        }
        (workers, ok_w) := p.parse_expr()
        if (!ok_w) {
            return (cpp::cfire::frontend::StmtPtr{
        }, false) }
        (tok_discard_29, ok_rp) := p.expect(cpp::cfire::frontend::TokenKind::RParen)
        if (!ok_rp) {
            return (cpp::cfire::frontend::StmtPtr{
        }, false) }
        (tok_discard_30, ok_p1) := p.expect(cpp::cfire::frontend::TokenKind::Pipe)
        if (!ok_p1) {
            return (cpp::cfire::frontend::StmtPtr{
        }, false) }
        (scope_var, ok_sv) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
        if (!ok_sv) {
            return (cpp::cfire::frontend::StmtPtr{
        }, false) }
        (tok_discard_31, ok_p2) := p.expect(cpp::cfire::frontend::TokenKind::Pipe)
        if (!ok_p2) {
            return (cpp::cfire::frontend::StmtPtr{
        }, false) }
        (body, ok_b) := p.parse_block()
        if (!ok_b) {
            return (cpp::cfire::frontend::StmtPtr{
        }, false) }
        return (cpp::cfire::frontend::make_stmt(cpp::cfire::frontend::AsyncScopeStmt{
            workers: workers,
            scope_var: scope_var.lexeme,
            body: body,
            line: tok.line,
        }, tok.line), true)
    }

    // Destructuring declaration: `mut (x, y) := expr`
    if (tok.kind == cpp::cfire::frontend::TokenKind::KwMut && p.peek(1).kind == cpp::cfire::frontend::TokenKind::LParen){
        (is_destr, is_decl) := p.is_destructure_lookahead(1)
        if (is_destr && is_decl) {
            p.advance() // 'mut'
            p.advance() // '('
            mut decl := cpp::cfire::frontend::DestructureVarDeclStmt{}
            decl.line = tok.line
            decl.col = tok.col
            for (p.cur().kind != cpp::cfire::frontend::TokenKind::RParen && p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
                if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwMut){
                    p.advance()
                }
                (id, ok_id) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
                if (!ok_id) {
                    return (cpp::cfire::frontend::StmtPtr{}, false)
                }
                decl.bindings.push(cpp::std::make_pair(id.lexeme, true))
                if (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma){
                    p.advance()
                }
            }
            (tok_discard_32, ok_rp) := p.expect(cpp::cfire::frontend::TokenKind::RParen)
            if (!ok_rp) {
                return (cpp::cfire::frontend::StmtPtr{}, false)
            }
            (tok_discard_33, ok_ce) := p.expect(cpp::cfire::frontend::TokenKind::ColonEq)
            if (!ok_ce) {
                return (cpp::cfire::frontend::StmtPtr{}, false)
            }
            (init, ok_in) := p.parse_expr()
            if (!ok_in) {
                return (cpp::cfire::frontend::StmtPtr{}, false)
            }
            decl.init = init
            return (cpp::cfire::frontend::make_stmt(decl, tok.line), true)
        }
    }

    // Destructuring declaration or assignment: `(x, y) := expr` or `(x, y) = expr`
    if (tok.kind == cpp::cfire::frontend::TokenKind::LParen){
        (is_destr, is_decl) := p.is_destructure_lookahead(0)
        if (is_destr && is_decl) {
            lp := p.advance() // '('
            mut decl := cpp::cfire::frontend::DestructureVarDeclStmt{}
            decl.line = lp.line
            decl.col = lp.col
            for (p.cur().kind != cpp::cfire::frontend::TokenKind::RParen && p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
                mut m := false
                if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwMut){
                    p.advance()
                    m = true
                }
                (id, ok_id) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
                if (!ok_id) {
                    return (cpp::cfire::frontend::StmtPtr{}, false)
                }
                decl.bindings.push(cpp::std::make_pair(id.lexeme, m))
                if (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma){
                    p.advance()
                }
            }
            (tok_discard_34, ok_rp) := p.expect(cpp::cfire::frontend::TokenKind::RParen)
            if (!ok_rp) {
                return (cpp::cfire::frontend::StmtPtr{}, false)
            }
            (tok_discard_35, ok_ce) := p.expect(cpp::cfire::frontend::TokenKind::ColonEq)
            if (!ok_ce) {
                return (cpp::cfire::frontend::StmtPtr{}, false)
            }
            (init, ok_in) := p.parse_expr()
            if (!ok_in) {
                return (cpp::cfire::frontend::StmtPtr{}, false)
            }
            decl.init = init
            return (cpp::cfire::frontend::make_stmt(decl, lp.line), true)
        }
        if (is_destr && !is_decl) {
            lp := p.advance() // '('
            mut targets: []cpp::cfire::frontend::ExprPtr = []
            for (p.cur().kind != cpp::cfire::frontend::TokenKind::RParen && p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
                (targ, ok_t) := p.parse_expr()
                if (!ok_t) { return (cpp::cfire::frontend::StmtPtr{
        }, false) }
                targets.push(targ)
                if (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma){
                    p.advance()
                }
            }
            (tok_discard_36, ok_rp) := p.expect(cpp::cfire::frontend::TokenKind::RParen)
            if (!ok_rp) {
                return (cpp::cfire::frontend::StmtPtr{
            }, false) }
            (tok_discard_37, ok_eq) := p.expect(cpp::cfire::frontend::TokenKind::Assign)
            if (!ok_eq) {
                return (cpp::cfire::frontend::StmtPtr{
            }, false) }
            (rhs, ok_rhs) := p.parse_expr()
            if (!ok_rhs) {
                return (cpp::cfire::frontend::StmtPtr{
            }, false) }
            return (cpp::cfire::frontend::make_stmt(cpp::cfire::frontend::DestructureAssignStmt{
                targets: targets,
                op: "=",
                value: rhs,
                line: lp.line,
            }, lp.line), true)
        }
    }

    if (tok.kind == cpp::cfire::frontend::TokenKind::Ident && p.peek(1).kind == cpp::cfire::frontend::TokenKind::ColonEq){
        id_tok := p.advance()
        p.advance() // ':='
        (init, ok_in) := p.parse_expr()
        if (!ok_in) { return (cpp::cfire::frontend::StmtPtr{
    }, false) }
        return (cpp::cfire::frontend::make_stmt(cpp::cfire::frontend::VarDeclStmt{
            name: id_tok.lexeme,
            is_mut: false,
            type: none,
            init: init,
            was_var: false,
            line: id_tok.line,
            col: id_tok.col,
        }, id_tok.line), true)
    }

    if (tok.kind == cpp::cfire::frontend::TokenKind::Ident && p.peek(1).kind == cpp::cfire::frontend::TokenKind::Colon){
        id_tok := p.advance()
        p.advance() // ':'
        (t_ref, ok_tr) := p.parse_type_ref()
        if (!ok_tr) { return (cpp::cfire::frontend::StmtPtr{
    }, false) }
        mut init := cpp::cfire::frontend::ExprPtr{}
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::Assign){
            p.advance()
            (ex, ok_ex) := p.parse_expr()
            if (!ok_ex) { return (cpp::cfire::frontend::StmtPtr{
        }, false) }
            init = ex
        }
        return (cpp::cfire::frontend::make_stmt(cpp::cfire::frontend::VarDeclStmt{
            name: id_tok.lexeme,
            is_mut: false,
            type: t_ref,
            init: init,
            was_var: false,
            line: id_tok.line,
            col: id_tok.col,
        }, id_tok.line), true)
    }

    (lhs, ok_lhs) := p.parse_expr()
    if (!ok_lhs) {
        return (cpp::cfire::frontend::StmtPtr{
    }, false) }

    k := p.cur().kind
    if (k == cpp::cfire::frontend::TokenKind::Assign ||
        k == cpp::cfire::frontend::TokenKind::PlusEq ||
        k == cpp::cfire::frontend::TokenKind::MinusEq) {
        op := p.advance().lexeme
        (rhs, ok_rhs) := p.parse_expr()
        if (!ok_rhs) { return (cpp::cfire::frontend::StmtPtr{
    }, false) }
        return (cpp::cfire::frontend::make_stmt(cpp::cfire::frontend::AssignStmt{
            target: lhs,
            op: op,
            value: rhs,
            line: tok.line,
        }, tok.line), true)
    }

    return (cpp::cfire::frontend::make_stmt(cpp::cfire::frontend::ExprStmt{
        expr: lhs,
        line: tok.line,
    }, tok.line), true)
}

fn (mut p: SelfhostParser) parse_if_stmt() -> (cpp::cfire::frontend::StmtPtr, bool) {
    start := p.advance() // 'if'
    (cond, ok_cond) := p.parse_expr()
    if (!ok_cond) {
        return (cpp::cfire::frontend::StmtPtr{
    }, false) }
    (then_body, ok_then) := p.parse_block()
    if (!ok_then) {
        return (cpp::cfire::frontend::StmtPtr{
    }, false) }
    mut else_body: []cpp::cfire::frontend::StmtPtr = []

    if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwElse){
        p.advance()
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwIf){
            (elif, ok_elif) := p.parse_if_stmt()
            if (!ok_elif) { return (cpp::cfire::frontend::StmtPtr{
    }, false) }
            else_body.push(elif)
        } else {
            (eb, ok_eb) := p.parse_block()
            if (!ok_eb) {
                return (cpp::cfire::frontend::StmtPtr{
            }, false) }
            else_body = eb
        }
    }
    return (cpp::cfire::frontend::make_stmt(cpp::cfire::frontend::IfStmt{
        cond: cond,
        then_body: then_body,
        else_body: else_body,
        line: start.line,
    }, start.line), true)
}

fn (mut p: SelfhostParser) parse_for_stmt() -> (cpp::cfire::frontend::StmtPtr, bool) {
    start := p.advance() // 'for'
    if p.cur().kind == cpp::cfire::frontend::TokenKind::Ident &&
       (p.peek(1).kind == cpp::cfire::frontend::TokenKind::Comma || p.peek(1).kind == cpp::cfire::frontend::TokenKind::KwIn) {
        first := p.advance().lexeme
        mut idx_var: str = ""
        mut item_var: str = ""
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma){
            p.advance()
            (second, ok_sec) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
            if (!ok_sec) { return (cpp::cfire::frontend::StmtPtr{
    }, false) }
            idx_var = first
            item_var = second.lexeme
        } else {
            item_var = first
        }
        (tok_discard_38, ok_in) := p.expect(cpp::cfire::frontend::TokenKind::KwIn)
        if (!ok_in) {
            return (cpp::cfire::frontend::StmtPtr{
        }, false) }
        (iter_ex, ok_iter) := p.parse_expr()
        if (!ok_iter) {
            return (cpp::cfire::frontend::StmtPtr{
        }, false) }
        (body, ok_b) := p.parse_block()
        if (!ok_b) {
            return (cpp::cfire::frontend::StmtPtr{
        }, false) }
        return (cpp::cfire::frontend::make_stmt(cpp::cfire::frontend::ForStmt{
            index_var: idx_var,
            item_var: item_var,
            iter_expr: iter_ex,
            body: body,
            line: start.line,
        }, start.line), true)
    }

    (cond, ok_c) := p.parse_expr()
    if (!ok_c) {
        return (cpp::cfire::frontend::StmtPtr{
    }, false) }
    (body, ok_b) := p.parse_block()
    if (!ok_b) {
        return (cpp::cfire::frontend::StmtPtr{
    }, false) }
    return (cpp::cfire::frontend::make_stmt(cpp::cfire::frontend::ForStmt{
        index_var: "",
        item_var: "",
        iter_expr: cond,
        body: body,
        line: start.line,
    }, start.line), true)
}

fn (mut p: SelfhostParser) parse_match_stmt() -> (cpp::cfire::frontend::StmtPtr, bool) {
    start := p.advance() // 'match'
    mut is_move := false
    if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwMove){
        p.advance()
        is_move = true
    }
    (target, ok_tgt) := p.parse_expr()
    if (!ok_tgt) {
        return (cpp::cfire::frontend::StmtPtr{
    }, false) }
    (tok_discard_39, ok_lb) := p.expect(cpp::cfire::frontend::TokenKind::LBrace)
    if (!ok_lb) {
        return (cpp::cfire::frontend::StmtPtr{
    }, false) }

    mut ms := cpp::cfire::frontend::MatchStmt{}
    ms.target = target
    ms.is_move = is_move
    ms.line = start.line
    ms.col = start.col

    for (p.cur().kind != cpp::cfire::frontend::TokenKind::RBrace && p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
        mut arm := cpp::cfire::frontend::MatchArm{}
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::LBracket){
            lb := p.advance() // '['
            arm.is_slice_pattern = true
            arm.line = lb.line
            mut in_tail := false
            for (p.cur().kind != cpp::cfire::frontend::TokenKind::RBracket && p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
                if (p.cur().kind == cpp::cfire::frontend::TokenKind::DotDot){
                    p.advance() // '..'
                    arm.slice_has_rest = true
                    if (p.cur().kind == cpp::cfire::frontend::TokenKind::Ident){
                        rest_id := p.advance().lexeme
                        if (rest_id != "_") {
                            arm.slice_rest = rest_id
        }
                    }
                    in_tail = true
                } else if (p.cur().kind == cpp::cfire::frontend::TokenKind::Ident) {
                    id := p.advance().lexeme
                    if (in_tail) {
                        arm.slice_tail.push(id)
                    } else {
                        arm.slice_head.push(id)
                    }
                } else {
                    err := p.file + ":" + parser_i32_to_str(p.cur().line) + ":" + parser_i32_to_str(p.cur().col) + ": unexpected token in slice pattern"
                    p.record_error(err)
                    return (cpp::cfire::frontend::StmtPtr{}, false)
                }
                if (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma){
                    p.advance()
                }
            }
            (tok_discard_40, ok_rb) := p.expect(cpp::cfire::frontend::TokenKind::RBracket)
            if (!ok_rb) {
                return (cpp::cfire::frontend::StmtPtr{
            }, false) }
        } else {
            (v_tok, ok_v) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
            if (!ok_v) {
                return (cpp::cfire::frontend::StmtPtr{
            }, false) }
            arm.line = v_tok.line
            if (p.cur().kind == cpp::cfire::frontend::TokenKind::DoubleColon || p.cur().kind == cpp::cfire::frontend::TokenKind::Dot){
                p.advance()
                (sub_tok, ok_sub) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
                if (!ok_sub) { return (cpp::cfire::frontend::StmtPtr{
            }, false) }
                arm.enum_prefix = v_tok.lexeme
                arm.variant_name = sub_tok.lexeme
            } else {
                arm.variant_name = v_tok.lexeme
            }

            if (p.cur().kind == cpp::cfire::frontend::TokenKind::LParen){
                p.advance() // '('
                for (p.cur().kind != cpp::cfire::frontend::TokenKind::RParen && p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
                    (b_tok, ok_b) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
                    if (!ok_b) { return (cpp::cfire::frontend::StmtPtr{
            }, false) }
                    arm.bindings.push(b_tok.lexeme)
                    if (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma){
                        p.advance()
                    }
                }
                (tok_discard_41, ok_rp) := p.expect(cpp::cfire::frontend::TokenKind::RParen)
                if (!ok_rp) {
                    return (cpp::cfire::frontend::StmtPtr{
                }, false) }
            }
        }

        (tok_discard_42, ok_fa) := p.expect(cpp::cfire::frontend::TokenKind::FatArrow)
        if (!ok_fa) {
            return (cpp::cfire::frontend::StmtPtr{
        }, false) }

        if (p.cur().kind == cpp::cfire::frontend::TokenKind::LBrace){
            (body, ok_b) := p.parse_block()
            if (!ok_b) { return (cpp::cfire::frontend::StmtPtr{
        }, false) }
            arm.body = body
        } else {
            (st, ok_st) := p.parse_stmt()
            if (!ok_st) {
                return (cpp::cfire::frontend::StmtPtr{
            }, false) }
            arm.body.push(st)
        }
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma){
            p.advance()
        }
        ms.arms.push(arm)
    }

    (tok_discard_43, ok_rb) := p.expect(cpp::cfire::frontend::TokenKind::RBrace)
    if (!ok_rb) {
        return (cpp::cfire::frontend::StmtPtr{
    }, false) }
    return (cpp::cfire::frontend::make_stmt(ms, start.line), true)
}

// --- Expression Parsing ---

fn (mut p: SelfhostParser) parse_expr() -> (cpp::cfire::frontend::ExprPtr, bool) {
    return p.parse_or_expr()
}

fn (mut p: SelfhostParser) parse_or_expr() -> (cpp::cfire::frontend::ExprPtr, bool) {
    (left, ok_left) := p.parse_binary_expr(1)
    if (!ok_left) {
        return (cpp::cfire::frontend::ExprPtr{
    }, false) }

    if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwOr){
        or_tok := p.advance()
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::Ident && p.peek(1).kind == cpp::cfire::frontend::TokenKind::LBrace){
            err_var := p.advance().lexeme
            (body, ok_b) := p.parse_block()
            if (!ok_b) { return (cpp::cfire::frontend::ExprPtr{
    }, false) }
            return (cpp::cfire::frontend::make_expr(cpp::cfire::frontend::OrExpr{
                inner: left,
                err_var: err_var,
                handler_body: body,
                fallback_val: cpp::cfire::frontend::ExprPtr{},
            }, or_tok.line, or_tok.col), true)
        }
        (fb, ok_fb) := p.parse_binary_expr(1)
        if (!ok_fb) {
            return (cpp::cfire::frontend::ExprPtr{
        }, false) }
        return (cpp::cfire::frontend::make_expr(cpp::cfire::frontend::OrExpr{
            inner: left,
            err_var: "",
            handler_body: [],
            fallback_val: fb,
        }, or_tok.line, or_tok.col), true)
    }
    return (left, true)
}

fn (mut p: SelfhostParser) parse_binary_expr(min_prec: i32) -> (cpp::cfire::frontend::ExprPtr, bool) {
    (mut left, ok_left) := p.parse_unary_expr()
    if (!ok_left) {
        return (left, false)
    }

    for true {
        k := p.cur().kind
        prec := get_binary_precedence(k)
        if (prec < min_prec) {
            break
        }
        op := p.advance()
        (right, ok_right) := p.parse_binary_expr(prec + 1)
        if (!ok_right) {
            return (cpp::cfire::frontend::ExprPtr{
        }, false) }
        left = cpp::cfire::frontend::make_expr(cpp::cfire::frontend::BinaryExpr{
            left: left,
            op: op.lexeme,
            right: right,
        }, op.line, op.col)
    }
    return (left, true)
}

fn (mut p: SelfhostParser) parse_unary_expr() -> (cpp::cfire::frontend::ExprPtr, bool) {
    tok := p.cur()
    if (tok.kind == cpp::cfire::frontend::TokenKind::KwTry){
        p.advance()
        (op, ok_op) := p.parse_unary_expr()
        if (!ok_op) { return (cpp::cfire::frontend::ExprPtr{
    }, false) }
        return (cpp::cfire::frontend::make_expr(cpp::cfire::frontend::TryExpr{inner: op}, tok.line, tok.col), true)
    }
    if (tok.kind == cpp::cfire::frontend::TokenKind::KwMove){
        p.advance()
        (op, ok_op) := p.parse_unary_expr()
        if (!ok_op) { return (cpp::cfire::frontend::ExprPtr{
    }, false) }
        return (cpp::cfire::frontend::make_expr(cpp::cfire::frontend::UnaryExpr{op: "move", operand: op}, tok.line, tok.col), true)
    }
    if (tok.kind == cpp::cfire::frontend::TokenKind::Bang || tok.kind == cpp::cfire::frontend::TokenKind::Star || tok.kind == cpp::cfire::frontend::TokenKind::Minus){
        p.advance()
        (op, ok_op) := p.parse_unary_expr()
        if (!ok_op) { return (cpp::cfire::frontend::ExprPtr{
    }, false) }
        return (cpp::cfire::frontend::make_expr(cpp::cfire::frontend::UnaryExpr{op: tok.lexeme, operand: op}, tok.line, tok.col), true)
    }
    if (tok.kind == cpp::cfire::frontend::TokenKind::Amp){
        p.advance()
        mut op_str: str = "&"
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwMut){
            p.advance()
            op_str = "&mut"
    }
        (op, ok_op) := p.parse_unary_expr()
        if (!ok_op) {
            return (cpp::cfire::frontend::ExprPtr{
        }, false) }
        return (cpp::cfire::frontend::make_expr(cpp::cfire::frontend::UnaryExpr{op: op_str, operand: op}, tok.line, tok.col), true)
    }
    return p.parse_postfix_expr()
}

fn (mut p: SelfhostParser) parse_postfix_expr() -> (cpp::cfire::frontend::ExprPtr, bool) {
    (mut expr, ok_expr) := p.parse_primary_expr()
    if (!ok_expr) {
        return (expr, false)
    }

    for true {
        k := p.cur().kind
        if (k == cpp::cfire::frontend::TokenKind::Dot || k == cpp::cfire::frontend::TokenKind::DoubleColon){
            sep := p.advance()
            mut field: str = ""
            if (p.cur().kind == cpp::cfire::frontend::TokenKind::Ident ||
                (p.cur().kind >= cpp::cfire::frontend::TokenKind::KwPackage && p.cur().kind <= cpp::cfire::frontend::TokenKind::KwNone)) {
                field = p.advance().lexeme
            } else {
                err := p.file + ":" + parser_i32_to_str(p.cur().line) + ":" + parser_i32_to_str(p.cur().col) + ": expected member name after '" + sep.lexeme + "'"
                p.record_error(err)
                return (cpp::cfire::frontend::ExprPtr{}, false)
            }
            expr = cpp::cfire::frontend::make_expr(cpp::cfire::frontend::MemberExpr{
                object: expr,
                field: field,
                is_namespace: (sep.kind == cpp::cfire::frontend::TokenKind::DoubleColon),
            }, sep.line, sep.col)
            continue
        }

        if (k == cpp::cfire::frontend::TokenKind::LBracket){
            if (p.is_generic_call_lookahead()) {
                saved_pos := p.pos
                p.advance() // '['
                mut type_args: []cpp::cfire::frontend::TypeRef = []
                mut ok := true
                for (p.cur().kind != cpp::cfire::frontend::TokenKind::RBracket && p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
                    (targ, ok_t) := p.parse_type_ref()
                    if (!ok_t) {
                        ok = false
                        break
        }
                    type_args.push(targ)
                    if (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma){
                        p.advance()
                    } else if (p.cur().kind != cpp::cfire::frontend::TokenKind::RBracket) {
                        ok = false
                        break
                    }
                }
                if (ok && p.cur().kind == cpp::cfire::frontend::TokenKind::RBracket){
                    p.advance() // ']'
                    (call, ok_call) := p.parse_call_with_callee(expr, type_args)
                    if (ok_call) {
                        expr = call
                        continue
                }
                }
                p.pos = saved_pos
            }

            br := p.advance() // '['
            if (p.cur().kind == cpp::cfire::frontend::TokenKind::DotDot){
                p.advance() // '..'
                mut end_ex := cpp::cfire::frontend::ExprPtr{
            }
                if (p.cur().kind != cpp::cfire::frontend::TokenKind::RBracket){
                    (e, ok_e) := p.parse_expr()
                    if (!ok_e) { return (cpp::cfire::frontend::ExprPtr{
                }, false) }
                    end_ex = e
                }
                (tok_discard_44, ok_rb) := p.expect(cpp::cfire::frontend::TokenKind::RBracket)
                if (!ok_rb) {
                    return (cpp::cfire::frontend::ExprPtr{
                }, false) }
                expr = cpp::cfire::frontend::make_expr(cpp::cfire::frontend::SliceExpr{
                    object: expr,
                    start: cpp::cfire::frontend::ExprPtr{},
                    end: end_ex,
                }, br.line, br.col)
                continue
            }

            (first, ok_first) := p.parse_expr()
            if (!ok_first) {
                return (cpp::cfire::frontend::ExprPtr{
            }, false) }

            if (p.cur().kind == cpp::cfire::frontend::TokenKind::DotDot){
                p.advance() // '..'
                mut end_ex := cpp::cfire::frontend::ExprPtr{
            }
                if (p.cur().kind != cpp::cfire::frontend::TokenKind::RBracket){
                    (e, ok_e) := p.parse_expr()
                    if (!ok_e) { return (cpp::cfire::frontend::ExprPtr{
                }, false) }
                    end_ex = e
                }
                (tok_discard_45, ok_rb) := p.expect(cpp::cfire::frontend::TokenKind::RBracket)
                if (!ok_rb) {
                    return (cpp::cfire::frontend::ExprPtr{
                }, false) }
                expr = cpp::cfire::frontend::make_expr(cpp::cfire::frontend::SliceExpr{
                    object: expr,
                    start: first,
                    end: end_ex,
                }, br.line, br.col)
                continue
            }

            (tok_discard_46, ok_rb) := p.expect(cpp::cfire::frontend::TokenKind::RBracket)
            if (!ok_rb) {
                return (cpp::cfire::frontend::ExprPtr{
            }, false) }
            expr = cpp::cfire::frontend::make_expr(cpp::cfire::frontend::IndexExpr{
                object: expr,
                index: first,
            }, br.line, br.col)
            continue
        }

        if (k == cpp::cfire::frontend::TokenKind::LParen){
            (is_destr, _) := p.is_destructure_lookahead(0)
            if (is_destr) {
                return (expr, true)
        }
            (call, ok_call) := p.parse_call_with_callee(expr, [])
            if (!ok_call) {
                return (cpp::cfire::frontend::ExprPtr{
            }, false) }
            expr = call
            continue
        }

        if (k == cpp::cfire::frontend::TokenKind::Pipe){
            (cl, ok_cl) := p.parse_closure_expr()
            if (!ok_cl) { return (cpp::cfire::frontend::ExprPtr{
        }, false) }
            expr = cpp::cfire::frontend::make_expr(cpp::cfire::frontend::CallExpr{
                callee: expr,
                type_args: [],
                args: [],
                block_arg: cl,
            }, (*expr).line, (*expr).col)
            continue
        }

        if (k == cpp::cfire::frontend::TokenKind::DoublePipe){
            if (p.peek(1).kind == cpp::cfire::frontend::TokenKind::LBrace){
                (cl, ok_cl) := p.parse_closure_expr()
                if (!ok_cl) { return (cpp::cfire::frontend::ExprPtr{
        }, false) }
                expr = cpp::cfire::frontend::make_expr(cpp::cfire::frontend::CallExpr{
                    callee: expr,
                    type_args: [],
                    args: [],
                    block_arg: cl,
                }, (*expr).line, (*expr).col)
                continue
            }
            return (expr, true)
        }

        break
    }
    return (expr, true)
}

fn (mut p: SelfhostParser) parse_call_with_callee(callee: cpp::cfire::frontend::ExprPtr, type_args: []cpp::cfire::frontend::TypeRef) -> (cpp::cfire::frontend::ExprPtr, bool) {
    lp := p.advance() // '('
    mut call := cpp::cfire::frontend::CallExpr{}
    call.callee = callee
    call.type_args = type_args

    // Special case for `make(...)`
    if (cpp::cfire::frontend::is_make_ident(callee)) {
        // Checking for make(shared[T], ...) or make(map[K]V, ...)
        k := p.cur().kind
        if k == cpp::cfire::frontend::TokenKind::LBracket || k == cpp::cfire::frontend::TokenKind::KwMap ||
           (k == cpp::cfire::frontend::TokenKind::Ident && (p.cur().lexeme == "own" || p.cur().lexeme == "shared") && p.peek(1).kind == cpp::cfire::frontend::TokenKind::LBracket) {
            (tref, ok_tr) := p.parse_type_ref()
            if (!ok_tr) { return (cpp::cfire::frontend::ExprPtr{
    }, false) }
            call.type_args.push(tref)
            if (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma){
                p.advance()
            }
        }
    }

    for (p.cur().kind != cpp::cfire::frontend::TokenKind::RParen && p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::Pipe || p.cur().kind == cpp::cfire::frontend::TokenKind::DoublePipe){
            (cl, ok_cl) := p.parse_closure_expr()
            if (!ok_cl) { return (cpp::cfire::frontend::ExprPtr{
        }, false) }
            call.block_arg = cl
            if (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma){
                p.advance()
            }
            continue
        }

        arg_tok := p.cur()
        mut intent: str = ""
        if (arg_tok.kind == cpp::cfire::frontend::TokenKind::KwMut ||
            arg_tok.kind == cpp::cfire::frontend::TokenKind::KwMove ||
            arg_tok.kind == cpp::cfire::frontend::TokenKind::KwOut) {
            intent = p.advance().lexeme
        }

        mut label: str = ""
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::Ident && p.peek(1).kind == cpp::cfire::frontend::TokenKind::Colon){
            label = p.advance().lexeme
            p.advance() // ':'
        }

        (val, ok_val) := p.parse_expr()
        if (!ok_val) {
            return (cpp::cfire::frontend::ExprPtr{
        }, false) }

        call.args.push(cpp::cfire::frontend::CallArg{
            intent: intent,
            label: label,
            value: val,
            line: arg_tok.line,
            col: arg_tok.col,
        })
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma){
            p.advance()
        }
    }

    (tok_discard_47, ok_rp) := p.expect(cpp::cfire::frontend::TokenKind::RParen)
    if (!ok_rp) {
        return (cpp::cfire::frontend::ExprPtr{
    }, false) }
    return (cpp::cfire::frontend::make_expr(call, lp.line, lp.col), true)
}

fn (mut p: SelfhostParser) parse_closure_expr() -> (cpp::cfire::frontend::ClosureExpr, bool) {
    mut cl := cpp::cfire::frontend::ClosureExpr{}
    if (p.cur().kind == cpp::cfire::frontend::TokenKind::DoublePipe){
        p.advance()
    } else {
        (tok_discard_48, ok_p1) := p.expect(cpp::cfire::frontend::TokenKind::Pipe)
        if (!ok_p1) {
            return (cl, false)
        }
        for (p.cur().kind != cpp::cfire::frontend::TokenKind::Pipe && p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
            (id, ok_id) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
            if (!ok_id) {
                return (cl, false)
            }
            cl.params.push(id.lexeme)
            if (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma){
                p.advance()
            }
        }
        (tok_discard_49, ok_p2) := p.expect(cpp::cfire::frontend::TokenKind::Pipe)
        if (!ok_p2) {
            return (cl, false)
        }
    }

    if (p.cur().kind == cpp::cfire::frontend::TokenKind::KwAsync){
        p.advance()
        cl.is_async = true
    }

    (body, ok_b) := p.parse_block()
    if (!ok_b) {
        return (cl, false)
    }
    cl.body = body
    return (cl, true)
}

fn (mut p: SelfhostParser) parse_primary_expr() -> (cpp::cfire::frontend::ExprPtr, bool) {
    tok := p.cur()
    k := tok.kind
    if (k == cpp::cfire::frontend::TokenKind::Int ||
        k == cpp::cfire::frontend::TokenKind::Float ||
        k == cpp::cfire::frontend::TokenKind::String ||
        k == cpp::cfire::frontend::TokenKind::RawString ||
        k == cpp::cfire::frontend::TokenKind::KwTrue ||
        k == cpp::cfire::frontend::TokenKind::KwFalse ||
        k == cpp::cfire::frontend::TokenKind::KwNone) {
        p.advance()
        return (cpp::cfire::frontend::make_expr(cpp::cfire::frontend::LiteralExpr{
            kind: tok.kind,
            value: tok.lexeme,
    }, tok.line, tok.col), true)
    }

    if (k == cpp::cfire::frontend::TokenKind::Ident || k == cpp::cfire::frontend::TokenKind::KwCpp){
        p.advance()
        mut name := tok.lexeme
        for p.cur().kind == cpp::cfire::frontend::TokenKind::DoubleColon ||
            (p.cur().kind == cpp::cfire::frontend::TokenKind::Dot && p.peek(1).kind == cpp::cfire::frontend::TokenKind::Ident &&
             p.peek(1).lexeme.len > 0 && p.peek(1).lexeme[0] >= 65 && p.peek(1).lexeme[0] <= 90 &&
             (p.peek(2).kind == cpp::cfire::frontend::TokenKind::LBrace || p.peek(2).kind == cpp::cfire::frontend::TokenKind::Dot)) {
            sep := p.advance()
            (next_id, ok_next) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
            if (!ok_next) { return (cpp::cfire::frontend::ExprPtr{
    }, false) }
            mut sep_str: str = "::"
            if (sep.kind == cpp::cfire::frontend::TokenKind::Dot){
                sep_str = "."
            }
            name = name + sep_str + next_id.lexeme
        }

        // Struct literal check: `Name { ... }`
        mut is_struct_lit := false
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::LBrace && name.len > 0){
            if (name.contains("::") || (name[0] >= 65 && name[0] <= 90)) {
                is_struct_lit = true
            } else if (name.contains(".")) {
                mut di := name.len - 1
                for (di > 0) {
                    if (name[di] == 46) { // '.'
                        if (di + 1 < name.len) {
                            c := name[di + 1]
                            if (c >= 65 && c <= 90) {
                                is_struct_lit = true
                            }
                        }
                        break
                    }
                    di = di - 1
                }
            }
        }

        if (is_struct_lit) {
            p.advance() // '{'
            mut st := cpp::cfire::frontend::StructLitExpr{
        }
            st.type_name = name
            for (p.cur().kind != cpp::cfire::frontend::TokenKind::RBrace && p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
                mut fn_name: str = ""
                if (p.cur().kind == cpp::cfire::frontend::TokenKind::Ident ||
                    (p.cur().kind >= cpp::cfire::frontend::TokenKind::KwPackage && p.cur().kind <= cpp::cfire::frontend::TokenKind::KwNone)) {
                    fn_name = p.advance().lexeme
                } else {
                    (fn_tok, ok_fn) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
                    if (!ok_fn) {
                        return (cpp::cfire::frontend::ExprPtr{}, false)
                    }
                    fn_name = fn_tok.lexeme
                }
                (tok_discard_50, ok_col) := p.expect(cpp::cfire::frontend::TokenKind::Colon)
                if (!ok_col) {
                    return (cpp::cfire::frontend::ExprPtr{}, false)
                }
                (fv, ok_fv) := p.parse_expr()
                if (!ok_fv) {
                    return (cpp::cfire::frontend::ExprPtr{}, false)
                }
                st.fields.push(cpp::cfire::frontend::StructLitField{
                    name: fn_name,
                    value: fv,
                })
                if (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma){
                    p.advance()
                }
            }
            (tok_discard_51, ok_rb) := p.expect(cpp::cfire::frontend::TokenKind::RBrace)
            if (!ok_rb) {
                return (cpp::cfire::frontend::ExprPtr{
            }, false) }
            return (cpp::cfire::frontend::make_expr(st, tok.line, tok.col), true)
        }

        return (cpp::cfire::frontend::make_expr(cpp::cfire::frontend::IdentExpr{name: name}, tok.line, tok.col), true)
    }

    if (k == cpp::cfire::frontend::TokenKind::LParen){
        p.advance() // '('
        if (p.cur().kind == cpp::cfire::frontend::TokenKind::RParen){
            p.advance() // ')'
            return (cpp::cfire::frontend::make_expr(cpp::cfire::frontend::TupleExpr{elements: []
    }, tok.line, tok.col), true)
        }
        (first, ok_first) := p.parse_expr()
        if (!ok_first) {
            return (cpp::cfire::frontend::ExprPtr{
        }, false) }

        if (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma){
            mut elements: []cpp::cfire::frontend::ExprPtr = []
            elements.push(first)
            for (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma) {
                p.advance() // ','
                if (p.cur().kind == cpp::cfire::frontend::TokenKind::RParen){
                    break
        }
                (next_ex, ok_next) := p.parse_expr()
                if (!ok_next) {
                    return (cpp::cfire::frontend::ExprPtr{
                }, false) }
                elements.push(next_ex)
            }
            (tok_discard_52, ok_rp) := p.expect(cpp::cfire::frontend::TokenKind::RParen)
            if (!ok_rp) {
                return (cpp::cfire::frontend::ExprPtr{
            }, false) }
            return (cpp::cfire::frontend::make_expr(cpp::cfire::frontend::TupleExpr{elements: elements}, tok.line, tok.col), true)
        }

        (tok_discard_53, ok_rp) := p.expect(cpp::cfire::frontend::TokenKind::RParen)
        if (!ok_rp) {
            return (cpp::cfire::frontend::ExprPtr{
        }, false) }
        return (first, true)
    }

    if (k == cpp::cfire::frontend::TokenKind::LBrace){
        p.advance() // '{'
        mut st := cpp::cfire::frontend::StructLitExpr{
    }
        for (p.cur().kind != cpp::cfire::frontend::TokenKind::RBrace && p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
            mut key: str = ""
            if (p.cur().kind == cpp::cfire::frontend::TokenKind::Ident || p.cur().kind == cpp::cfire::frontend::TokenKind::String){
                key = p.advance().lexeme
            }
            if (p.cur().kind == cpp::cfire::frontend::TokenKind::Colon){
                p.advance()
            }
            (fv, ok_fv) := p.parse_expr()
            if (!ok_fv) {
                return (cpp::cfire::frontend::ExprPtr{
            }, false) }
            st.fields.push(cpp::cfire::frontend::StructLitField{
                name: key,
                value: fv,
            })
            if (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma){
                p.advance()
            }
        }
        (tok_discard_54, ok_rb) := p.expect(cpp::cfire::frontend::TokenKind::RBrace)
        if (!ok_rb) {
            return (cpp::cfire::frontend::ExprPtr{
        }, false) }
        return (cpp::cfire::frontend::make_expr(st, tok.line, tok.col), true)
    }

    if (k == cpp::cfire::frontend::TokenKind::LBracket){
        p.advance() // '['
        mut arr := cpp::cfire::frontend::ArrayLitExpr{
    }
        for (p.cur().kind != cpp::cfire::frontend::TokenKind::RBracket && p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
            (el, ok_el) := p.parse_expr()
            if (!ok_el) {
                return (cpp::cfire::frontend::ExprPtr{
            }, false) }
            arr.elements.push(el)
            if (p.cur().kind == cpp::cfire::frontend::TokenKind::Comma){
                p.advance()
            }
        }
        (tok_discard_55, ok_rb) := p.expect(cpp::cfire::frontend::TokenKind::RBracket)
        if (!ok_rb) {
            return (cpp::cfire::frontend::ExprPtr{
        }, false) }
        return (cpp::cfire::frontend::make_expr(arr, tok.line, tok.col), true)
    }

    err := p.file + ":" + parser_i32_to_str(tok.line) + ":" + parser_i32_to_str(tok.col) + ": unexpected token '" + tok.lexeme + "' in expression"
    p.record_error(err)
    return (cpp::cfire::frontend::ExprPtr{}, false)
}

// --- Top-Level File Parser ---

fn (mut p: SelfhostParser) parse_file_result() -> cpp::cfire::frontend::ParseResult {
    mut f := cpp::cfire::frontend::FileAST{}
    f.path = p.file

    (pkg_kw, ok_pkg) := p.expect(cpp::cfire::frontend::TokenKind::KwPackage)
    if (!ok_pkg) {
        if (!p.resilient) { return cpp::cfire::frontend::ParseResult{ast: f, errors: p.errors
    } }
        p.synchronize_decl()
    } else {
        (pkg_id, ok_id) := p.expect(cpp::cfire::frontend::TokenKind::Ident)
        if (!ok_id) {
            if (!p.resilient) { return cpp::cfire::frontend::ParseResult{ast: f, errors: p.errors
        } }
            p.synchronize_decl()
        } else {
            f.package_name = pkg_id.lexeme
        }
    }

    for (p.cur().kind != cpp::cfire::frontend::TokenKind::Eof) {
        k := p.cur().kind
        if (k == cpp::cfire::frontend::TokenKind::KwImport){
            (imp, ok_imp) := p.parse_import()
            if (!ok_imp) {
                if (!p.resilient) { return cpp::cfire::frontend::ParseResult{ast: f, errors: p.errors
        } }
                p.synchronize_decl()
            } else {
                f.imports.push(imp)
            }
        } else if (k == cpp::cfire::frontend::TokenKind::KwType) {
            ok_td := p.parse_type_decl(mut f)
            if (!ok_td) {
                if (!p.resilient) { return cpp::cfire::frontend::ParseResult{ast: f, errors: p.errors
            } }
                p.synchronize_decl()
            }
        } else if (k == cpp::cfire::frontend::TokenKind::KwFn) {
            (fn_decl, ok_fn) := p.parse_fn_decl()
            if (!ok_fn) {
                if (!p.resilient) { return cpp::cfire::frontend::ParseResult{ast: f, errors: p.errors
            } }
                p.synchronize_decl()
            } else {
                f.functions.push(fn_decl)
            }
        } else if (k == cpp::cfire::frontend::TokenKind::KwVar) {
            (gv, ok_gv) := p.parse_global_var()
            if (!ok_gv) {
                if (!p.resilient) { return cpp::cfire::frontend::ParseResult{ast: f, errors: p.errors
            } }
                p.synchronize_decl()
            } else {
                f.global_vars.push(gv)
            }
        } else if (k == cpp::cfire::frontend::TokenKind::KwMut) {
            if (p.peek(1).kind == cpp::cfire::frontend::TokenKind::Ident){
                (gv, ok_gv) := p.parse_global_var()
                if (!ok_gv) {
                    if (!p.resilient) { return cpp::cfire::frontend::ParseResult{ast: f, errors: p.errors
            } }
                    p.synchronize_decl()
                } else {
                    f.global_vars.push(gv)
                }
            } else {
                err := p.file + ":" + parser_i32_to_str(p.cur().line) + ":" + parser_i32_to_str(p.cur().col) + ": unexpected 'mut' at top-level"
                p.record_error(err)
                if (!p.resilient) {
                    return cpp::cfire::frontend::ParseResult{ast: f, errors: p.errors
                } }
                p.synchronize_decl()
            }
        } else if (k == cpp::cfire::frontend::TokenKind::Ident) {
            p1 := p.peek(1).kind
            if (p1 == cpp::cfire::frontend::TokenKind::ColonEq || p1 == cpp::cfire::frontend::TokenKind::Colon){
                (gv, ok_gv) := p.parse_global_var()
                if (!ok_gv) {
                    if (!p.resilient) { return cpp::cfire::frontend::ParseResult{ast: f, errors: p.errors
            } }
                    p.synchronize_decl()
                } else {
                    f.global_vars.push(gv)
                }
            } else {
                err := p.file + ":" + parser_i32_to_str(p.cur().line) + ":" + parser_i32_to_str(p.cur().col) + ": unexpected identifier '" + p.cur().lexeme + "' at top-level"
                p.record_error(err)
                if (!p.resilient) {
                    return cpp::cfire::frontend::ParseResult{ast: f, errors: p.errors
                } }
                p.synchronize_decl()
            }
        } else if (k == cpp::cfire::frontend::TokenKind::KwTest) {
            (td, ok_td) := p.parse_test_decl()
            if (!ok_td) {
                if (!p.resilient) { return cpp::cfire::frontend::ParseResult{ast: f, errors: p.errors
            } }
                p.synchronize_decl()
            } else {
                f.tests.push(td)
            }
        } else {
            err := p.file + ":" + parser_i32_to_str(p.cur().line) + ":" + parser_i32_to_str(p.cur().col) + ": unexpected top-level token '" + p.cur().lexeme + "'"
            p.record_error(err)
            if (!p.resilient) {
                return cpp::cfire::frontend::ParseResult{ast: f, errors: p.errors
            } }
            p.synchronize_decl()
        }
    }

    return cpp::cfire::frontend::ParseResult{
        ast: f,
        errors: p.errors,
    }
}

// --- Entry Points ---

fn selfhost_parse_file_result(file: &str, tokens: []cpp::cfire::frontend::Token, resilient: bool) -> cpp::cfire::frontend::ParseResult {
    mut parser := make_parser(file, tokens, resilient)
    return parser.parse_file_result()
}
