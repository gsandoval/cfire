package refactor

// src/refactor.cf — Self-Hosted Semantic CLI Renaming & Refactoring Engine for cfire

type Occurrence struct {
    file_path: str
    line: usize     // 1-indexed
    col: usize      // 1-indexed
    end_col: usize  // 1-indexed
}

type FileModification struct {
    file_path: str
    original_content: str
    modified_content: str
    occurrences: []Occurrence
}

type RenameResult struct {
    success: bool
    old_name: str
    new_name: str
    error: str
    modifications: []FileModification
    total_occurrences: usize
}

// is_keyword: Verifies whether an identifier collides with any cfire language keyword
fn is_keyword(name: &str) -> bool {
    if name == "package" || name == "import" || name == "cpp" || name == "cplusplus" || name == "as" {
        return true
    }
    if name == "type" || name == "struct" || name == "enum" || name == "interface" || name == "map" {
        return true
    }
    if name == "fn" || name == "async" || name == "in" || name == "mut" || name == "out" || name == "move" || name == "var" {
        return true
    }
    if name == "if" || name == "else" || name == "for" || name == "match" || name == "defer" || name == "return" || name == "try" || name == "or" || name == "test" {
        return true
    }
    if name == "true" || name == "false" || name == "none" || name == "nil" || name == "null" {
        return true
    }
    return false
}

// is_valid_identifier: Validates standard identifier syntax [a-zA-Z_][a-zA-Z0-9_]* and keyword exclusivity
fn is_valid_identifier(name: &str) -> bool {
    n := name.len
    if n == 0 {
        return false
    }
    c0 := name[0]
    if !((c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122) || c0 == 95) {
        return false
    }
    mut idx: usize = 1
    for idx < n {
        c := name[idx]
        if !((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95) {
            return false
        }
        idx = idx + 1
    }
    if is_keyword(name) {
        return false
    }
    return true
}

// split_lines: Splits text into lines separated by \n (stripping optional trailing \r)
fn split_lines(text: &str) -> []str {
    mut lines: []str = []
    n := text.len
    if n == 0 {
        return lines
    }
    mut start: usize = 0
    mut i: usize = 0
    for i < n {
        if text[i] == 10 { // '\n'
            mut end := i
            if end > start && text[end - 1] == 13 { // '\r'
                end = end - 1
            }
            lines.push("" + text[start..end])
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        mut end := n
        if end > start && text[end - 1] == 13 {
            end = end - 1
        }
        lines.push("" + text[start..end])
    }
    return lines
}

// json_escape: Escapes string characters for valid JSON output
fn json_escape(sv: &str) -> str {
    mut escaped: str = ""
    mut start: usize = 0
    mut i: usize = 0
    n := sv.len
    for i < n {
        c := sv[i]
        if c == 34 || c == 92 || c == 10 || c == 13 || c == 9 {
            if i > start {
                escaped += sv[start..i]
            }
            if c == 34 {
                escaped += "\\\""
            } else if c == 92 {
                escaped += "\\\\"
            } else if c == 10 {
                escaped += "\\n"
            } else if c == 13 {
                escaped += "\\r"
            } else if c == 9 {
                escaped += "\\t"
            }
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        escaped += sv[start..n]
    }
    return escaped
}

// usize_to_str: Formats a non-negative integer into its ASCII decimal representation
fn usize_to_str(val: usize) -> str {
    if val == 0 {
        return "0"
    }
    mut v := val
    mut digits: str = ""
    for v > 0 {
        d := v % 10
        if d == 0 {
            digits = "0" + digits
        } else if d == 1 {
            digits = "1" + digits
        } else if d == 2 {
            digits = "2" + digits
        } else if d == 3 {
            digits = "3" + digits
        } else if d == 4 {
            digits = "4" + digits
        } else if d == 5 {
            digits = "5" + digits
        } else if d == 6 {
            digits = "6" + digits
        } else if d == 7 {
            digits = "7" + digits
        } else if d == 8 {
            digits = "8" + digits
        } else if d == 9 {
            digits = "9" + digits
        }
        v = v / 10
    }
    return digits
}

// apply_line_replacements: Replaces identifier occurrences descending by line and column to avoid coordinate drift
fn apply_line_replacements(original_content: &str, occurrences: []Occurrence, new_name: &str) -> str {
    if occurrences.len == 0 {
        return "" + original_content
    }
    mut file_lines := split_lines(original_content)

    // Sort occurrences descending by line and column
    mut occs: []Occurrence = []
    mut oi: usize = 0
    num_occs := occurrences.len
    for oi < num_occs {
        occs.push(occurrences[oi])
        oi = oi + 1
    }

    mut i: usize = 1
    for i < occs.len {
        key := occs[i]
        mut j := i
        for j > 0 {
            cur := occs[j - 1]
            mut should_swap := false
            if cur.line < key.line {
                should_swap = true
            } else if cur.line == key.line && cur.col < key.col {
                should_swap = true
            }
            if should_swap {
                occs[j] = cur
                j = j - 1
            } else {
                break
            }
        }
        occs[j] = key
        i = i + 1
    }

    mut k: usize = 0
    for k < occs.len {
        occ := occs[k]
        if occ.line > 0 {
            ln_idx := occ.line - 1
            if ln_idx < file_lines.len {
                cur_line := file_lines[ln_idx]
                if occ.col > 0 && occ.end_col >= occ.col {
                    sc := occ.col - 1
                    ec := occ.end_col - 1
                    if sc <= cur_line.len && ec <= cur_line.len {
                        prefix := cur_line[0..sc]
                        suffix := cur_line[ec..cur_line.len]
                        mut replaced_line: str = ""
                        replaced_line += prefix
                        replaced_line += new_name
                        replaced_line += suffix
                        file_lines[ln_idx] = replaced_line
                    }
                }
            }
        }
        k = k + 1
    }

    mut modded: str = ""
    mut li: usize = 0
    n_lines := file_lines.len
    has_trailing_nl := original_content.len > 0 && original_content[original_content.len - 1] == 10
    for li < n_lines {
        modded += file_lines[li]
        if li + 1 < n_lines || has_trailing_nl {
            modded += "\n"
        }
        li = li + 1
    }
    return modded
}

// generate_unified_diff: Produces standard unified diff format (--- a/..., +++ b/..., @@ -l,c +l,c @@)
fn generate_unified_diff(res: &RenameResult) -> str {
    mut diff: str = ""
    mut m_idx: usize = 0
    n_mods := res.modifications.len
    for m_idx < n_mods {
        mod := res.modifications[m_idx]
        orig_lines := split_lines(mod.original_content)
        mod_lines := split_lines(mod.modified_content)

        diff += "--- a/"
        diff += mod.file_path
        diff += "\n+++ b/"
        diff += mod.file_path
        diff += "\n"

        mut i: usize = 0
        mut max_lines := orig_lines.len
        if mod_lines.len > max_lines {
            max_lines = mod_lines.len
        }

        for i < max_lines {
            if i < orig_lines.len && i < mod_lines.len && orig_lines[i] == mod_lines[i] {
                i = i + 1
                continue
            }
            mut hunk_start: usize = 0
            if i >= 2 {
                hunk_start = i - 2
            }
            mut hunk_end := i + 3
            if hunk_end > max_lines {
                hunk_end = max_lines
            }

            mut o_end := hunk_end
            if o_end > orig_lines.len {
                o_end = orig_lines.len
            }
            mut o_start := hunk_start
            if o_start > orig_lines.len {
                o_start = orig_lines.len
            }
            orig_len := o_end - o_start

            mut m_end := hunk_end
            if m_end > mod_lines.len {
                m_end = mod_lines.len
            }
            mut m_start := hunk_start
            if m_start > mod_lines.len {
                m_start = mod_lines.len
            }
            mod_len := m_end - m_start

            diff += "@@ -"
            diff += usize_to_str(hunk_start + 1)
            diff += ","
            diff += usize_to_str(orig_len)
            diff += " +"
            diff += usize_to_str(hunk_start + 1)
            diff += ","
            diff += usize_to_str(mod_len)
            diff += " @@\n"

            mut k := hunk_start
            for k < hunk_end {
                if k < orig_lines.len && k < mod_lines.len && orig_lines[k] == mod_lines[k] {
                    diff += " "
                    diff += orig_lines[k]
                    diff += "\n"
                } else {
                    if k < orig_lines.len {
                        diff += "-"
                        diff += orig_lines[k]
                        diff += "\n"
                    }
                    if k < mod_lines.len {
                        diff += "+"
                        diff += mod_lines[k]
                        diff += "\n"
                    }
                }
                k = k + 1
            }
            i = hunk_end
        }
        m_idx = m_idx + 1
    }
    return diff
}

// to_json: Emits machine-readable JSON summary of rename modifications and occurrences
fn to_json(res: &RenameResult) -> str {
    if !res.success {
        mut err_json: str = "{\"success\":false,\"error\":\""
        err_json += json_escape(res.error)
        err_json += "\"}\n"
        return err_json
    }
    mut json_str: str = "{\n"
    json_str += "  \"success\": true,\n"
    json_str += "  \"old_name\": \""
    json_str += json_escape(res.old_name)
    json_str += "\",\n"
    json_str += "  \"new_name\": \""
    json_str += json_escape(res.new_name)
    json_str += "\",\n"
    json_str += "  \"files_modified\": "
    json_str += usize_to_str(res.modifications.len)
    json_str += ",\n"
    json_str += "  \"total_occurrences\": "
    json_str += usize_to_str(res.total_occurrences)
    json_str += ",\n"
    json_str += "  \"files\": [\n"
    mut i: usize = 0
    num_mods := res.modifications.len
    for i < num_mods {
        if i > 0 {
            json_str += ",\n"
        }
        mod := res.modifications[i]
        json_str += "    {\n"
        json_str += "      \"file\": \""
        json_str += json_escape(mod.file_path)
        json_str += "\",\n"
        json_str += "      \"occurrences_count\": "
        json_str += usize_to_str(mod.occurrences.len)
        json_str += ",\n"
        json_str += "      \"occurrences\": ["
        mut j: usize = 0
        num_occs := mod.occurrences.len
        for j < num_occs {
            if j > 0 {
                json_str += ", "
            }
            occ := mod.occurrences[j]
            json_str += "{\"line\":"
            json_str += usize_to_str(occ.line)
            json_str += ",\"col\":"
            json_str += usize_to_str(occ.col)
            json_str += ",\"end_col\":"
            json_str += usize_to_str(occ.end_col)
            json_str += "}"
            j = j + 1
        }
        json_str += "]\n    }"
        i = i + 1
    }
    json_str += "\n  ]\n}\n"
    return json_str
}
