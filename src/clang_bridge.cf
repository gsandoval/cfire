package clang_bridge
// src/clang_bridge.cf — Clang AST Header Ingestor & Persistent Cache
// Self-hosted in pure cfire with 100% parity against native C++ clang_bridge.

type CppParsedFnSig struct {
    return_type: str
    param_types: []str
}

type CppCacheEntry struct {
    key: str
    name: str
    kind: str
    return_type: str
    param_types: []str
}

fn bitwise_xor_byte(a: u64, b: u8) -> u64 {
    cpp {
        return a ^ static_cast<uint64_t>(b);
    }
}

fn get_fnv1a_initial_offset() -> u64 {
    cpp {
        return 0xcbf29ce484222325ULL;
    }
}

fn selfhost_clang_hash_key(s: &str) -> u64 {
    mut h: u64 = get_fnv1a_initial_offset()
    prime: u64 = 1099511628211
    mut i: usize = 0
    n := s.len
    for i < n {
        c := s[i]
        h = bitwise_xor_byte(h, c)
        h = h * prime
        i = i + 1
    }
    return h
}

fn selfhost_clang_trim_qual(s: &str) -> str {
    mut start: usize = 0
    n := s.len
    for start < n && (s[start] == 32 || s[start] == 9) {
        start = start + 1
    }
    mut end: usize = n
    for end > start && (s[end - 1] == 32 || s[end - 1] == 9) {
        end = end - 1
    }
    mut res: str = ""
    res += s[start..end]
    return res
}

fn selfhost_clang_parse_fn_sig(full_sig: &str) -> CppParsedFnSig {
    mut res := CppParsedFnSig{
        return_type: "",
        param_types: []
    }
    n := full_sig.len
    mut lp: usize = n
    mut rp: usize = n
    mut i: usize = 0
    for i < n {
        if full_sig[i] == 40 && lp == n { // '('
            lp = i
        }
        if full_sig[i] == 41 { // ')'
            rp = i
        }
        i = i + 1
    }

    if lp == n || rp == n || rp <= lp {
        res.return_type = selfhost_clang_trim_qual(full_sig)
        return res
    }

    res.return_type = selfhost_clang_trim_qual(full_sig[0..lp])
    params_sv := selfhost_clang_trim_qual(full_sig[(lp + 1)..rp])
    if params_sv.len == 0 || params_sv == "void" {
        return res
    }

    mut depth: i32 = 0
    mut start: usize = 0
    pn := params_sv.len
    mut j: usize = 0
    for j < pn {
        c := params_sv[j]
        if c == 60 || c == 40 { // '<' or '('
            depth = depth + 1
        } else if c == 62 || c == 41 { // '>' or ')'
            depth = depth - 1
        } else if c == 44 && depth == 0 { // ','
            pt := selfhost_clang_trim_qual(params_sv[start..j])
            if pt.len > 0 {
                res.param_types.push(pt)
            }
            start = j + 1
        }
        j = j + 1
    }
    last_pt := selfhost_clang_trim_qual(params_sv[start..pn])
    if last_pt.len > 0 {
        res.param_types.push(last_pt)
    }
    return res
}

fn selfhost_clang_format_cache_entry(entry: CppCacheEntry) -> str {
    mut line: str = entry.key + "\t" + entry.name + "\t" + entry.kind + "\t" + entry.return_type
    mut i: usize = 0
    n := entry.param_types.len
    for i < n {
        line += "\t" + entry.param_types[i]
        i = i + 1
    }
    line += "\n"
    return line
}

fn selfhost_clang_parse_cache_line(line: &str) -> CppCacheEntry {
    mut res := CppCacheEntry{
        key: "",
        name: "",
        kind: "",
        return_type: "",
        param_types: []
    }
    mut cols: []str = []
    mut start: usize = 0
    n := line.len
    mut i: usize = 0
    for i < n {
        if line[i] == 9 { // '\t'
            mut col: str = ""
            col += line[start..i]
            cols.push(col)
            start = i + 1
        }
        i = i + 1
    }
    if start <= n {
        mut last_col: str = ""
        last_col += line[start..n]
        cols.push(last_col)
    }

    if cols.len >= 4 {
        res.key = cols[0]
        res.name = cols[1]
        res.kind = cols[2]
        res.return_type = cols[3]
        mut ci: usize = 4
        cn := cols.len
        for ci < cn {
            res.param_types.push(cols[ci])
            ci = ci + 1
        }
    }
    return res
}
