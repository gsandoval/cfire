package main_driver
// src/main.cf — Native CLI Driver & Dispatch Engine
// Self-hosted in pure cfire with 100% parity against native C++ main driver.

type RefactorCliArgs struct {
    action: str
    target_file: str
    target_line: i32
    target_col: i32
    new_name: str
    apply_mode: bool
    diff_mode: bool
    dry_run_mode: bool
    json_mode: bool
    valid: bool
    error_message: str
}

fn selfhost_get_usage() -> str {
    mut u: str = "Usage: cfire <command> [args...]\n"
    u += "Commands:\n"
    u += "  run      <file.cf>            Transpile to C++23, auto-link core/vendor/cpp deps, and run\n"
    u += "  test     <file.cf>            Compile and execute all `test \"...\" { ... }` blocks in file\n"
    u += "  build    [--target <triple>] <file.cf> Compile optimized binary for host or target triple\n"
    u += "  eval     [-e <expr>|code]     Evaluate one-shot statement, expression, or stdin\n"
    u += "  refactor rename <loc> <to>    Semantic symbol rename across workspace (--diff, --apply, --json)\n"
    u += "  check    [--json] <file.cf>   Type-check, verify parameter intents, and inspect C++ headers\n"
    u += "  outline  [--json] [path]      Token-compressed outline of packages, types, and functions\n"
    u += "  fmt      [--check] <path>     Canonically format .cf file(s) or directory\n"
    u += "  lsp                           Start built-in Language Server Protocol (JSON-RPC 2.0 stdio)\n"
    u += "  ide      [editor|--all]       Configure IDE (VS Code, Cursor, Zed, Neovim, CLion)\n"
    u += "  doc      [--check|--llm|<f>]  Generate docs site, guide, or LLM agent reference sheet\n"
    u += "  emit-cpp <file.cf>            Print generated human-readable C++23 source\n"
    u += "  eject    <file.cf> [out_dir]  Export standalone C++23 source tree + CMakeLists.txt\n"
    u += "  vendor   [dest_dir]           Fetch and vendor all build.cf dependencies for offline builds\n"
    return u
}

fn selfhost_get_llm_doc() -> str {
    mut d: str = "# cfire Language Reference Sheet for LLMs & AI Agents\n"
    d += "Grammar:\n"
    d += "- Package: `package <name>` (canonical: main)\n"
    d += "- Imports: `import \"core:<mod>\"`, `import \"./path\"`, `import cpp \"header.h\" @define(\"MACRO\")`\n"
    d += "- Declarations:\n"
    d += "  - Const: `x := 42`, `name: str = \"cfire\"`\n"
    d += "  - Mutable: `mut y := 10`, `mut count: i64 = 0`\n"
    d += "- Signatures: `fn name(in a: i32, mut b: str, move c: []byte) -> Ret! { ... }`\n"
    d += "  - Fallible return: `-> T!` lowers to `std::expected<T, cfire::Error>`\n"
    d += "  - Optional return: `-> T?` lowers to `std::optional<T>`\n"
    d += "  - Tuples: `fn coords() -> (f64, f64) { return (1.0, 2.0) }`, deconstruct: `(x, y) := coords()`\n"
    d += "- Types:\n"
    d += "  - Struct: `type User struct { id: i64, name: str `json:\"name\"` }`\n"
    d += "  - Enum: `type Shape enum { Circle(f64), Rect(f64, f64) }`\n"
    d += "  - Interface: `type Writer interface { write(b: []byte) -> usize! }`\n"
    d += "- Control Flow:\n"
    d += "  - `if cond { ... } else { ... }`\n"
    d += "  - `for item in slice { ... }` / `for i, item in slice { ... }`\n"
    d += "  - `match val { Shape::Circle(r) => 3.14 * r * r, Shape::Rect(w, h) => w * h }`\n"
    d += "  - `defer resource.close()`\n"
    d += "- Error Handling:\n"
    d += "  - `val := try fallible()` (early return on error)\n"
    d += "  - `val := fallible() or fallback_expr`\n"
    d += "  - `val := fallible() or err { return -1 }` (must diverge or panic)\n"
    d += "- Foreign C/C++: `cpp { /* verbatim C++23 */ }`\n"
    d += "- Standard Library Modules:\n"
    d += "  - `core:fs`: open, File (read, read_all, write, seek, tell, flush, close), dirname, basename, extension\n"
    d += "  - `core:json`: parse_dynamic, stringify_dynamic, Value, decode[T], stringify[T]\n"
    d += "  - `core:net/http`: get, post, make_server; `core:net/url`: parse, encode, decode\n"
    d += "  - `core:unicode`: rune_count, runes, is_valid_utf8, to_lower, to_upper, encode_rune\n"
    d += "  - `core:os`: command, exec, getenv; `core:os/exec`: exec.command\n"
    d += "  - `core:time`: now, Duration, format_rfc3339, parse_rfc3339\n"
    d += "  - `core:regex`: compile, is_match, replace_all\n"
    d += "  - `core:collections`: Set[T], PriorityQueue[T], Deque[T]\n"
    d += "  - `core:sort`: slice, slice_by, binary_search\n"
    d += "  - `core:crypto/sha256`: hash_hex, hash_bytes; `core:crypto/rand`: bytes\n"
    d += "  - `core:log`: set_level, debug, info, warn, error"
    return d
}

fn driver_starts_with(s: &str, prefix: &str) -> bool {
    n := s.len
    pn := prefix.len
    if pn > n {
        return false
    }
    return s[0..pn] == prefix
}

fn driver_find_first_not_of_ws(s: &str) -> usize {
    mut i: usize = 0
    n := s.len
    for i < n {
        c := s[i]
        if c != 32 && c != 9 && c != 10 && c != 13 {
            return i
        }
        i = i + 1
    }
    return n
}

fn driver_find_char(s: &str, ch: u8, start: usize) -> usize {
    mut i: usize = start
    n := s.len
    for i < n {
        if s[i] == ch {
            return i
        }
        i = i + 1
    }
    return n
}

fn driver_parse_i32(s: &str) -> i32 {
    mut res: i32 = 0
    mut i: usize = 0
    n := s.len
    for i < n {
        c := s[i]
        if c >= 48 && c <= 57 {
            res = res * 10 + (c - 48)
        }
        i = i + 1
    }
    return res
}

fn selfhost_wrap_eval_code(raw_code: str, expr_mode: bool) -> str {
    start := driver_find_first_not_of_ws(raw_code)
    n := raw_code.len
    if start < n {
        trimmed := raw_code[start..n]
        if driver_starts_with(trimmed, "package ") {
            return raw_code
        }
    }

    mut imports: []str = []
    mut decls: []str = []
    mut stmts: []str = []

    mut in_decl_block: bool = false
    mut brace_depth: i32 = 0
    mut current_block: str = ""

    mut line_start: usize = 0
    mut i: usize = 0
    for i <= n {
        if i == n || raw_code[i] == 10 {
            mut line_end := i
            if line_end > line_start && raw_code[line_end - 1] == 13 {
                line_end = line_end - 1
            }
            line := raw_code[line_start..line_end]
            line_start = i + 1

            ls := driver_find_first_not_of_ws(line)
            ln := line.len
            mut ltrim: str = ""
            if ls < ln {
                ltrim = line[ls..ln]
            }

            mut line_str: str = ""
            line_str += line

            if !in_decl_block && driver_starts_with(ltrim, "import ") {
                imports.push(line_str)
            } else if !in_decl_block && (driver_starts_with(ltrim, "fn ") || driver_starts_with(ltrim, "type ")) {
                in_decl_block = true
                current_block = line_str + "\n"
                mut j: usize = 0
                for j < ln {
                    c := line[j]
                    if c == 123 {
                        brace_depth = brace_depth + 1
                    } else if c == 125 {
                        brace_depth = brace_depth - 1
                    }
                    j = j + 1
                }
                if brace_depth <= 0 {
                    in_decl_block = false
                    decls.push(current_block)
                    current_block = ""
                    brace_depth = 0
                }
            } else if in_decl_block {
                current_block += line_str + "\n"
                mut j: usize = 0
                for j < ln {
                    c := line[j]
                    if c == 123 {
                        brace_depth = brace_depth + 1
                    } else if c == 125 {
                        brace_depth = brace_depth - 1
                    }
                    j = j + 1
                }
                if brace_depth <= 0 {
                    in_decl_block = false
                    decls.push(current_block)
                    current_block = ""
                    brace_depth = 0
                }
            } else {
                stmts.push(line_str)
            }
        }
        i = i + 1
    }

    mut result_code: str = "package main\n\n"
    result_code += "import \"core:fs\"\n"
    result_code += "import \"core:str\"\n"
    result_code += "import \"core:math\"\n"
    result_code += "import \"core:time\"\n"
    result_code += "import \"core:unicode\"\n"

    mut imp_i: usize = 0
    n_imp := imports.len
    for imp_i < n_imp {
        result_code += imports[imp_i] + "\n"
        imp_i = imp_i + 1
    }
    result_code += "\n"

    mut dec_i: usize = 0
    n_dec := decls.len
    for dec_i < n_dec {
        result_code += decls[dec_i] + "\n"
        dec_i = dec_i + 1
    }
    result_code += "\n"

    result_code += "fn main() {\n"
    if expr_mode {
        mut joined_stmts: str = ""
        mut stmt_i: usize = 0
        n_stmts := stmts.len
        for stmt_i < n_stmts {
            if joined_stmts.len > 0 {
                joined_stmts += " "
            }
            joined_stmts += stmts[stmt_i]
            stmt_i = stmt_i + 1
        }
        result_code += "    println(\"{}\", " + joined_stmts + ")\n"
    } else {
        mut stmt_i: usize = 0
        n_stmts := stmts.len
        for stmt_i < n_stmts {
            result_code += "    " + stmts[stmt_i] + "\n"
            stmt_i = stmt_i + 1
        }
    }
    result_code += "}\n"

    return result_code
}

fn selfhost_parse_refactor_args(args: []str) -> RefactorCliArgs {
    mut res := RefactorCliArgs{
        action: "",
        target_file: "",
        target_line: 0,
        target_col: 1,
        new_name: "",
        apply_mode: false,
        diff_mode: false,
        dry_run_mode: false,
        json_mode: false,
        valid: false,
        error_message: ""
    }

    n := args.len
    if n < 3 {
        res.error_message = "missing required arguments for refactor"
        return res
    }

    res.action = args[2]
    if res.action != "rename" {
        res.error_message = "unknown refactor action '" + res.action + "' (supported: rename)"
        return res
    }

    mut i: usize = 3
    for i < n {
        arg := args[i]
        if arg == "--apply" {
            res.apply_mode = true
        } else if arg == "--diff" {
            res.diff_mode = true
        } else if arg == "--dry-run" {
            res.dry_run_mode = true
        } else if arg == "--json" {
            res.json_mode = true
        } else if arg == "--file" && i + 1 < n {
            i = i + 1
            res.target_file = args[i]
        } else if arg == "--line" && i + 1 < n {
            i = i + 1
            res.target_line = driver_parse_i32(args[i])
        } else if arg == "--col" && i + 1 < n {
            i = i + 1
            res.target_col = driver_parse_i32(args[i])
        } else if arg == "--to" && i + 1 < n {
            i = i + 1
            res.new_name = args[i]
        } else if res.target_file.len == 0 && driver_find_char(arg, 58, 0) < arg.len {
            first_colon := driver_find_char(arg, 58, 0)
            second_colon := driver_find_char(arg, 58, first_colon + 1)
            res.target_file = arg[0..first_colon]
            if second_colon < arg.len {
                res.target_line = driver_parse_i32(arg[first_colon + 1 .. second_colon])
                res.target_col = driver_parse_i32(arg[second_colon + 1 .. arg.len])
            } else {
                res.target_line = driver_parse_i32(arg[first_colon + 1 .. arg.len])
                res.target_col = 1
            }
        } else if res.new_name.len == 0 {
            res.new_name = arg
        }
        i = i + 1
    }

    if res.target_file.len == 0 || res.target_line <= 0 || res.new_name.len == 0 {
        res.error_message = "error: missing required arguments for refactor rename"
        return res
    }

    if res.target_col <= 0 {
        res.target_col = 1
    }
    res.valid = true
    return res
}

fn selfhost_run_driver(args: []str, runtime_dir: str) -> i32 {
    if args.len < 2 {
        return cpp::cfire::main_driver::run_usage()
    }
    sub := args[1]

    if sub == "lsp" {
        return cpp::cfire::main_driver::run_lsp()
    }

    if sub == "ide" {
        mut editor: str = "auto"
        if args.len >= 3 {
            editor = args[2]
        }
        return cpp::cfire::main_driver::run_ide(editor, runtime_dir)
    }

    if sub == "eval" {
        mut expr_mode: bool = false
        mut raw_code: str = ""
        mut i: usize = 2
        n := args.len
        for i < n {
            arg := args[i]
            if arg == "-e" {
                expr_mode = true
                if i + 1 < n {
                    next_arg := args[i + 1]
                    if next_arg.len == 0 || next_arg[0] != 45 {
                        i = i + 1
                        raw_code = args[i]
                    }
                }
            } else if raw_code.len == 0 {
                raw_code = arg
            } else {
                raw_code += " "
                raw_code += arg
            }
            i = i + 1
        }

        return cpp::cfire::main_driver::run_eval(raw_code, expr_mode, runtime_dir)
    }

    if sub == "refactor" {
        rf := selfhost_parse_refactor_args(args)
        return cpp::cfire::main_driver::run_refactor(
            rf.target_file,
            rf.target_line,
            rf.target_col,
            rf.new_name,
            rf.apply_mode,
            rf.diff_mode,
            rf.dry_run_mode,
            rf.json_mode,
            rf.valid,
            rf.error_message
        )
    }

    if sub == "vendor" {
        mut target_dir: str = "vendor"
        if args.len >= 3 {
            target_dir = args[2]
        }
        return cpp::cfire::main_driver::run_vendor(target_dir)
    }

    if sub == "doc" {
        mut check_only: bool = false
        mut llm_mode: bool = false
        mut target_cf: str = ""
        mut i: usize = 2
        n := args.len
        for i < n {
            arg := args[i]
            if arg == "--check" {
                check_only = true
            } else if arg == "--llm" {
                llm_mode = true
            } else {
                target_cf = arg
            }
            i = i + 1
        }
        llm_doc := selfhost_get_llm_doc()
        return cpp::cfire::main_driver::run_doc(check_only, llm_mode, target_cf, runtime_dir, llm_doc)
    }

    if sub == "fmt" {
        mut check_only: bool = false
        mut to_stdout: bool = false
        mut target_path: str = "."
        mut i: usize = 2
        n := args.len
        for i < n {
            arg := args[i]
            if arg == "--check" {
                check_only = true
            } else if arg == "--stdout" {
                to_stdout = true
            } else {
                target_path = arg
            }
            i = i + 1
        }
        return cpp::cfire::main_driver::run_fmt(target_path, check_only, to_stdout)
    }

    if sub == "outline" {
        mut target_path: str = "."
        mut i: usize = 2
        n := args.len
        for i < n {
            arg := args[i]
            if arg != "--json" {
                target_path = arg
            }
            i = i + 1
        }
        return cpp::cfire::main_driver::run_outline(target_path)
    }

    if args.len < 3 {
        return cpp::cfire::main_driver::run_usage()
    }

    mut sanitize: bool = false
    mut json_mode: bool = false
    mut target_triple: str = ""
    mut sysroot: str = ""
    mut target: str = ""
    mut run_args: []str = []
    mut after_dashdash: bool = false

    mut opt_i: usize = 2
    n_args := args.len
    for opt_i < n_args {
        arg := args[opt_i]
        if after_dashdash {
            run_args.push(arg)
        } else if arg == "--" {
            after_dashdash = true
        } else if arg == "--sanitize" {
            sanitize = true
        } else if arg == "--json" {
            json_mode = true
        } else if (arg == "--target" || arg == "-target") && opt_i + 1 < n_args {
            opt_i = opt_i + 1
            target_triple = args[opt_i]
        } else if driver_starts_with(arg, "--target=") {
            target_triple = arg[9..arg.len]
        } else if driver_starts_with(arg, "-target=") {
            target_triple = arg[8..arg.len]
        } else if arg == "--sysroot" && opt_i + 1 < n_args {
            opt_i = opt_i + 1
            sysroot = args[opt_i]
        } else if driver_starts_with(arg, "--sysroot=") {
            sysroot = arg[10..arg.len]
        } else if target.len == 0 {
            target = arg
        } else {
            run_args.push(arg)
        }
        opt_i = opt_i + 1
    }

    if target.len == 0 {
        return cpp::cfire::main_driver::run_usage()
    }

    if sub == "emit-cpp" {
        return cpp::cfire::main_driver::run_emit_cpp(target, runtime_dir, target_triple, sysroot)
    }

    if sub == "check" {
        return cpp::cfire::main_driver::run_check(target, runtime_dir, json_mode, target_triple, sysroot)
    }

    if sub == "build" {
        return cpp::cfire::main_driver::run_build(target, runtime_dir, sanitize, target_triple, sysroot)
    }

    if sub == "run" || sub == "test" {
        is_test := (sub == "test")
        return cpp::cfire::main_driver::run_test(target, runtime_dir, is_test, sanitize, target_triple, sysroot, run_args)
    }

    if sub == "eject" {
        mut out_dir: str = "ejected_cpp"
        if args.len >= 4 {
            out_dir = args[3]
        }
        return cpp::cfire::main_driver::run_eject(target, runtime_dir, out_dir)
    }

    return cpp::cfire::main_driver::run_usage()
}
