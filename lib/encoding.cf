package encoding

fn hex_encode(s: str) -> str {
    digits := "0123456789abcdef"
    mut res: str = ""
    mut i: usize = 0
    n := s.len
    for i < n {
        mut val: i64 = s[i]
        if val < 0 {
            val = val + 256
        }
        hi := (val / 16) % 16
        lo := val % 16
        res += digits[hi..hi+1]
        res += digits[lo..lo+1]
        i = i + 1
    }
    return res
}

fn hex_char_val(c: i64) -> i64 {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 97 + 10
    }
    if c >= 65 && c <= 70 {
        return c - 65 + 10
    }
    return -1
}

fn hex_decode(s: str) -> str! {
    if s.len % 2 != 0 {
        return error("odd hex string length")
    }
    mut res: str = ""
    mut i: usize = 0
    n := s.len
    for i < n {
        hi := hex_char_val(s[i])
        lo := hex_char_val(s[i + 1])
        if hi < 0 || lo < 0 {
            return error("invalid hex character")
        }
        byte_val := (hi * 16) + lo
        res.push_back(byte_val)
        i = i + 2
    }
    return res
}

fn base64_encode(s: str, url_safe: bool) -> str {
    mut tbl: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    if url_safe {
        tbl = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    }
    mut res: str = ""
    mut i: usize = 0
    n := s.len
    for i < n {
        remaining := n - i
        mut b0: i64 = s[i]
        if b0 < 0 { b0 = b0 + 256 }
        mut b1: i64 = 0
        if remaining > 1 {
            b1 = s[i + 1]
            if b1 < 0 { b1 = b1 + 256 }
        }
        mut b2: i64 = 0
        if remaining > 2 {
            b2 = s[i + 2]
            if b2 < 0 { b2 = b2 + 256 }
        }
        triple := (b0 * 65536) + (b1 * 256) + b2
        c0 := (triple / 262144) % 64
        c1 := (triple / 4096) % 64
        c2 := (triple / 64) % 64
        c3 := triple % 64

        res += tbl[c0..c0+1]
        res += tbl[c1..c1+1]
        if remaining > 1 {
            res += tbl[c2..c2+1]
        } else if !url_safe {
            res += "="
        }

        if remaining > 2 {
            res += tbl[c3..c3+1]
        } else if !url_safe {
            res += "="
        }

        if remaining >= 3 {
            i = i + 3
        } else {
            i = i + remaining
        }
    }
    return res
}

fn b64_char_val(c: i64) -> i64 {
    if c >= 65 && c <= 90 { return c - 65 }
    if c >= 97 && c <= 122 { return c - 97 + 26 }
    if c >= 48 && c <= 57 { return c - 48 + 52 }
    if c == 43 || c == 45 { return 62 }
    if c == 47 || c == 95 { return 63 }
    if c == 61 { return -1 }
    return -2
}

fn base64_decode(s: str) -> str! {
    mut res: str = ""
    mut quad: []i64 = []
    mut i: usize = 0
    n := s.len
    for i < n {
        c := s[i]
        if c == 32 || c == 9 || c == 10 || c == 13 {
            i = i + 1
            continue
        }
        val := b64_char_val(c)
        if val == -2 {
            return error("invalid base64 character")
        }
        quad.push(val)
        if quad.len == 4 {
            b0 := quad[0]
            b1 := quad[1]
            b2 := quad[2]
            b3 := quad[3]
            if b0 < 0 || b1 < 0 {
                return error("malformed base64 padding")
            }
            mut b2_val: i64 = b2
            if b2 < 0 { b2_val = 0 }
            mut b3_val: i64 = b3
            if b3 < 0 { b3_val = 0 }

            triple := (b0 * 262144) + (b1 * 4096) + (b2_val * 64) + b3_val
            byte0 := (triple / 65536) % 256
            byte1 := (triple / 256) % 256
            byte2 := triple % 256

            res.push_back(byte0)
            if b2 != -1 {
                res.push_back(byte1)
            }
            if b3 != -1 {
                res.push_back(byte2)
            }
            quad = []
        }
        i = i + 1
    }

    if quad.len > 0 {
        if quad.len == 1 {
            return error("truncated base64 input")
        }
        b0 := quad[0]
        b1 := quad[1]
        if b0 < 0 || b1 < 0 {
            return error("malformed base64")
        }
        mut b2: i64 = -1
        if quad.len > 2 {
            b2 = quad[2]
        }
        mut b2_val: i64 = b2
        if b2 < 0 { b2_val = 0 }
        triple := (b0 * 262144) + (b1 * 4096) + (b2_val * 64)
        byte0 := (triple / 65536) % 256
        byte1 := (triple / 256) % 256
        res.push_back(byte0)
        if b2 != -1 {
            res.push_back(byte1)
        }
    }
    return res
}

fn csv_parse(s: str) -> [][]str {
    mut rows: [][]str = []
    mut current_row: []str = []
    mut current_field: str = ""
    mut in_quotes: bool = false
    mut i: usize = 0
    n := s.len

    for i < n {
        c := s[i]
        if in_quotes {
            if c == 34 {
                if i + 1 < n && s[i + 1] == 34 {
                    current_field += "\""
                    i = i + 2
                } else {
                    in_quotes = false
                    i = i + 1
                }
            } else {
                current_field += s[i..i+1]
                i = i + 1
            }
        } else {
            if c == 34 {
                in_quotes = true
                i = i + 1
            } else if c == 44 {
                current_row.push(current_field)
                current_field = ""
                i = i + 1
            } else if c == 13 {
                if i + 1 < n && s[i + 1] == 10 {
                    i = i + 1
                }
                current_row.push(current_field)
                current_field = ""
                rows.push(current_row)
                current_row = []
                i = i + 1
            } else if c == 10 {
                current_row.push(current_field)
                current_field = ""
                rows.push(current_row)
                current_row = []
                i = i + 1
            } else {
                current_field += s[i..i+1]
                i = i + 1
            }
        }
    }

    if current_field.len > 0 || current_row.len > 0 {
        current_row.push(current_field)
        rows.push(current_row)
    }

    return rows
}

fn csv_stringify(rows: [][]str) -> str {
    mut res: str = ""
    mut r: usize = 0
    num_rows := rows.len
    for r < num_rows {
        row := rows[r]
        mut c: usize = 0
        num_cols := row.len
        for c < num_cols {
            if c > 0 {
                res += ","
            }
            cell := row[c]
            mut needs_quote: bool = false
            mut k: usize = 0
            cell_len := cell.len
            for k < cell_len {
                ch := cell[k]
                if ch == 44 || ch == 34 || ch == 13 || ch == 10 {
                    needs_quote = true
                    break
                }
                k = k + 1
            }
            if needs_quote {
                res += "\""
                mut j: usize = 0
                for j < cell_len {
                    ch := cell[j]
                    if ch == 34 {
                        res += "\"\""
                    } else {
                        res += cell[j..j+1]
                    }
                    j = j + 1
                }
                res += "\""
            } else {
                res += cell
            }
            c = c + 1
        }
        res += "\r\n"
        r = r + 1
    }
    return res
}
