{
  "name": "cfire",
  "version": "0.10.0",
  "description": "Official cfire (.cf) Language Server (LSP) plugin for Claude Code.",
  "lspServers": {
    "cfire": {
      "command": "cfire",
      "args": ["lsp"],
      "transport": "stdio",
      "extensionToLanguage": {
        ".cf": "cfire"
      }
    }
  }
}
