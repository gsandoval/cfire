package raygui_ext

import "vendor:raylib" as rl
import "vendor:raygui" as rg

test "raygui_ext extended codepoints builder" {
    cps := build_extended_codepoints()
    assert(cps.len() > 500)

    // Check ASCII range (e.g. 65 is 'A')
    assert_eq(cps[33], 65)

    // Check Spanish accents and symbols are populated
    mut has_spanish_accent := false
    mut has_arrow := false
    for cp in cps {
        if cp == 0x00E9 { // 'é'
            has_spanish_accent = true
        }
        if cp == 0x2192 { // '→'
            has_arrow = true
        }
    }
    assert(has_spanish_accent)
    assert(has_arrow)
}

test "raygui_ext splitter style and headless safety" {
    style := default_splitter_style()
    assert_eq(style.hit_width, 10.0)
    assert_eq(style.bar_width, 2.0)

    // Headless invocation when window is not ready should safely return false without crashing
    mut split_x: f32 = 250.0
    mut dragging: bool = false
    changed_v := GuiSplitterV(0.0, 600.0, 100.0, 500.0, mut split_x, mut dragging, style)
    assert(!changed_v)
    assert_eq(split_x, 250.0)

    mut split_y: f32 = 180.0
    mut dragging_h: bool = false
    changed_h := GuiSplitterH(0.0, 800.0, 50.0, 400.0, mut split_y, mut dragging_h, style)
    assert(!changed_h)
    assert_eq(split_y, 180.0)
}

test "raygui_ext text buffer word and line navigation" {
    sample := "Primera línea con acentos\nSegunda línea: diseño mecánico"
    w1 := editor_move_word_right(sample, 0)
    assert_eq(w1, 8) // Start of "línea"
    w0 := editor_move_word_left(sample, w1)
    assert_eq(w0, 0) // Back to start of "Primera"

    le := editor_move_line_end(sample, 3)
    assert_eq(le, 26) // Before \n
    ls := editor_move_line_start(sample, 30)
    assert_eq(ls, 27) // After \n
}

test "raygui_ext text insert and delete operations" {
    mut t1 := "hello "
    mut cur1: i32 = 6
    mut anc1: i32 = -1
    text_insert_at(mut t1, mut cur1, mut anc1, "world")
    assert_eq(t1, "hello world")
    assert_eq(cur1, 11)

    // Selection replacement
    mut t2 := "123abc456"
    mut cur2: i32 = 6
    mut anc2: i32 = 3
    text_insert_at(mut t2, mut cur2, mut anc2, "XYZ")
    assert_eq(t2, "123XYZ456")
    assert_eq(cur2, 6)

    // Backspace single UTF-8 codepoint ('í' is 2 bytes: offsets 1..3)
    mut t3 := "línea"
    mut cur3: i32 = 3 // after 'í'
    mut anc3: i32 = -1
    del_ok := text_delete_selection_or_backspace(mut t3, mut cur3, mut anc3)
    assert(del_ok)
    assert_eq(t3, "lnea")
    assert_eq(cur3, 1)
}

test "raygui_ext spanish and international accent variants" {
    vars_e := get_spanish_accent_variants("e", false)
    assert_eq(vars_e.len(), 4)
    assert_eq(vars_e[0], "é")

    vars_n := get_spanish_accent_variants("N", true)
    assert_eq(vars_n.len(), 1)
    assert_eq(vars_n[0], "Ñ")

    vars_q := get_spanish_accent_variants("?", false)
    assert_eq(vars_q.len(), 1)
    assert_eq(vars_q[0], "¿")

    vars_ex := get_spanish_accent_variants("!", false)
    assert_eq(vars_ex.len(), 1)
    assert_eq(vars_ex[0], "¡")
}

test "raygui_ext visual row wrapping and multi-line navigation" {
    text := "First line of text\nSecond line with some additional content"
    vrows := compute_visual_rows(rl.Font{}, text, 800.0, 15.0)
    assert(vrows.len() >= 2)
    assert_eq(vrows[0].logical_line, 1)
    assert_eq(vrows[1].logical_line, 2)

    // UTF-8 indices for "línea"
    sample := "línea"
    next_idx := next_utf8_index(sample, 1) // after 'l'
    assert_eq(next_idx, 3) // after 'í' (2 bytes)
    prev_idx := prev_utf8_index(sample, 3)
    assert_eq(prev_idx, 1) // back to 'l'

    // Up and down line navigation
    doc := "12345\n67890"
    down_c := move_down_one_line(doc, 2)
    assert_eq(down_c, 8) // '8' in line 2
    up_c := move_up_one_line(doc, down_c)
    assert_eq(up_c, 2) // back to '3' in line 1

    // UTF-8 rune encoder
    r_a := utf8_encode_rune(65)
    assert_eq(r_a, "A")
    r_e := utf8_encode_rune(0x00E9)
    assert_eq(r_e, "é")
}

test "raygui_ext embedded font fallback loading" {
    rl.SetConfigFlags(rl.FLAG_WINDOW_HIDDEN)
    rl.InitWindow(100, 100, "Font Fallback Test")
    defer rl.CloseWindow()

    f := GuiLoadSystemFontExtended([], 24)
    assert(f.texture.id > 0)
    assert_eq(f.baseSize, 24)
    assert(f.glyphCount > 400)

    // Test embedded Source Code Pro mono font fallback
    f_mono := GuiLoadSystemMonoFontExtended([], 24)
    assert(f_mono.texture.id > 0)
    assert_eq(f_mono.baseSize, 24)
    assert(f_mono.glyphCount > 400)
}

fuzz "utf8 cursor and word navigation never slice mid-codepoint" |s: str, raw_pos: i32| {
    n := s.len()
    p_idx := prev_utf8_index(s, raw_pos)
    n_idx := next_utf8_index(s, raw_pos)
    wl := editor_move_word_left(s, raw_pos)
    wr := editor_move_word_right(s, raw_pos)
    ls := editor_move_line_start(s, raw_pos)
    le := editor_move_line_end(s, raw_pos)
    up := move_up_one_line(s, raw_pos)
    dn := move_down_one_line(s, raw_pos)

    assert(p_idx >= 0 && p_idx <= n)
    assert(n_idx >= 0 && n_idx <= n)
    assert(wl >= 0 && wl <= n)
    assert(wr >= 0 && wr <= n)
    assert(ls >= 0 && ls <= n)
    assert(le >= 0 && le <= n)
    assert(up >= 0 && up <= n)
    assert(dn >= 0 && dn <= n)

    if p_idx < n { assert((u8(s[p_idx]) & 0xC0) != 0x80) }
    if n_idx < n { assert((u8(s[n_idx]) & 0xC0) != 0x80) }
    if wl < n { assert((u8(s[wl]) & 0xC0) != 0x80) }
    if wr < n { assert((u8(s[wr]) & 0xC0) != 0x80) }
}

fuzz "text_insert_at and backspace/delete preserve valid cursor bounds" |initial: str, snippet: str, raw_cur: i32| {
    mut buf := initial
    mut cur := raw_cur
    mut sel: i32 = -1
    text_insert_at(mut buf, mut cur, mut sel, snippet)
    assert(cur >= 0 && cur <= buf.len())
    assert_eq(sel, -1)

    _ = text_delete_selection_or_backspace(mut buf, mut cur, mut sel)
    assert(cur >= 0 && cur <= buf.len())

    _ = text_delete_selection_or_delete(mut buf, mut cur, mut sel)
    assert(cur >= 0 && cur <= buf.len())
}

bench "build_extended_codepoints" {
    cps := build_extended_codepoints()
    assert(cps.len() > 500)
}

bench "compute_visual_rows wrapping" |lines in [10, 50]| {
    mut doc := ""
    for i in 0..lines {
        doc = "{doc}Line {i}: Primera línea con diseño mecánico y ajuste automático\n"
    }
    vrows := compute_visual_rows(rl.Font{}, doc, 320.0, 15.0)
    assert(vrows.len() >= lines)
}
