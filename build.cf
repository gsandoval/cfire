package build

// build.cf — Canonical Project Manifest & Self-Building Engine for cfire
//
// Allows cfire to build itself:
//   cfire build src/main.cf
//   cfire vendor
//   cfire eject src/main.cf

import "core:build"

var Cfire = build.Executable("cfire", {
    Entry: "src/main.cf",
    Includes: ["runtime", "src"],
})
