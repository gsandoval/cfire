package main

import "core:net"

fn fetch_status(endpoint: str, port: u16) -> i32! {
    mut conn := try net.connect_tcp(endpoint, port)
    _ = try conn.write_text("HEAD / HTTP/1.1\r\nHost: localhost\r\n\r\n")
    return 200
}

fn check_cluster(hosts: &[]str, port: u16) -> []i32 {
    mut codes := make([]i32, hosts.len)
    async.scope(workers: 4) |scope| {
        for i, h in hosts {
            slot := &mut codes[i]
            scope.spawn || {
                *slot = fetch_status(h, port) or 503
            }
        }
    }
    return codes
}

fn main() {
    mut ln := try net.listen_tcp(0)
    port := ln.port()

    mut hosts: []str
    hosts.push("127.0.0.1")
    hosts.push("unreachable.node")
    hosts.push("localhost")

    codes := check_cluster(hosts, port)
    println("Cluster health codes: [{}, {}, {}]", codes[0], codes[1], codes[2])
}
