package main

import "core:time"
import "core:os"
import "core:sync"
import "core:math"
import "core:rand"
import "core:json"
import "core:net"

type Metric struct {
    service: str  `json:"service"`
    count:   i64  `json:"count"`
    latency: f64  `json:"latency"`
    healthy: bool `json:"healthy"`
}

type Box struct {
    value: i32
}

/// Computes the sum of a 4-element fixed-size array.
/// ```cf
/// arr: [4]i32 = [10, 20, 30, 40]
/// sum := compute_fixed_sum(arr)
/// assert_eq(sum, 100)
/// ```
fn compute_fixed_sum(arr: [4]i32) -> i32 {
    mut acc: i32 = 0
    for i in 0..4 {
        acc += arr[i]
    }
    return acc
}

fn run_app() -> void! {
    // 1. core:str, core:os, core:math, core:rand, core:time
    t0 := time.now_ms()
    os.setenv("CFIRE_ENV_MODE", "production")
    env_mode := os.getenv("CFIRE_ENV_MODE", "dev").to_upper()
    parts := "alpha,beta,gamma".split(",")
    joined := parts.join("-")
    clamped := rand.range_i64(10, 20).clamp(0, 100)

    // 2. Smart pointers (`own[T]`, `shared[T]`) and fixed-size `[4]i32`
    owned_box := make(own[Box], Box{value: 42})
    shared_box := make(shared[Box], Box{value: 58})
    fixed_arr: [4]i32 = [10, 20, 30, 40]
    sum_out := compute_fixed_sum(fixed_arr)

    // 3. core:json roundtrip (`stringify` + `parse` with str, i64, f64, bool)
    m_in := Metric{
        service: joined,
        count:   128,
        latency: 1.5,
        healthy: true,
    }
    encoded := json.stringify(m_in)
    m_out := try json.parse[Metric](encoded)

    // 4. core:sync Channel[i64] + core:net real POSIX loopback TCP socket
    ch := make(sync.Channel[i64])
    mut listener := try net.listen(0)
    port := listener.port()

    async.scope(workers: 2) |scope| {
        scope.spawn || {
            mut client := net.connect("127.0.0.1", port) or err {
                return
            }
            _ = client.write_text("PING_CFIRE") or 0
            ch.send(777)
        }
    }

    mut server_conn := try listener.accept()
    tcp_msg := try server_conn.read_text(64)
    ch_val := ch.recv() or 0
    elapsed := time.now_ms() - t0

    println("Stdlib: env={} service={} count={} healthy={} ptr_sum={} arr_sum={} tcp={} ch={} (elapsed={}ms, clamped={})",
        env_mode, m_out.service, m_out.count, m_out.healthy,
        owned_box.value + shared_box.value, sum_out, tcp_msg, ch_val, elapsed >= 0, clamped >= 10)
}

test "smart pointers and fixed array summation" {
    b := make(own[Box], Box{value: 99})
    assert_eq(b.value, 99, "expected owned box value 99")

    arr: [4]i32 = [1, 2, 3, 4]
    total := compute_fixed_sum(arr)
    assert_eq(total, 10, "expected fixed array sum 10")
}

test "core:str and core:math utilities" {
    trimmed := "  sapphire on fire  ".trim()
    assert_eq(trimmed, "sapphire on fire", "trim check")
    assert_eq((500).clamp(0, 100), 100, "clamp check")
}

fuzz "math.clamp_i64 stays within bounds" |x: i64| {
    c := x.clamp(-50, 50)
    assert(c >= -50 && c <= 50)
}

bench "str.split and str.join throughput" |n in [8, 32]| {
    mut items: []str = []
    for i in 0..n {
        items.push("part-{i}")
    }
    joined := items.join(",")
    split_back := joined.split(",")
    assert_eq(split_back.len(), n)
}

fn main() {
    run_app() or err {
        println("error: {}", err.message())
    }
}
